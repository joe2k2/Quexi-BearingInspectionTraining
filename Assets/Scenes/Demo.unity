  m_Script: {fileID: 11500000, guid: c346c43a98d48bb4e8dd62813623c3b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Text: "\u0BB5\u0BBF\u0B9A\u0BBE\u0BB0\u0BA3\u0BC8 \u0B9A\u0BAA\u0BC8 \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
    \u0B86\u0BAF\u0BCD\u0BB5\u0BC1 \u0BAA\u0BAF\u0BBF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BC1
    \u0BB5\u0BB0\u0BC1\u0B95.\r\n\r\n\u0B87\u0BA8\u0BCD\u0BA4 \u0B95\u0BB2\u0BAA\u0BCD\u0BAA\u0BC1
    \u0BB0\u0BBF\u0BAF\u0BBE\u0BB2\u0BBF\u0B9F\u0BCD\u0B9F\u0BBF \u0B85\u0BA9\u0BC1\u0BAA\u0BB5\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD,
    \u0BA8\u0BC0\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0B92\u0BB5\u0BCD\u0BB5\u0BCA\u0BB0\u0BC1
    \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BC8\u0BAF\u0BC1\u0BAE\u0BCD
    \u0B86\u0BB0\u0BBE\u0BAF\u0BCD\u0BB5\u0BC0\u0BB0\u0BCD\u0B95\u0BB3\u0BCD, \u0B85\u0BA4\u0BA9\u0BCD
    \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BC8\u0BAA\u0BCD
    \u0BAA\u0BC1\u0BB0\u0BBF\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BCA\u0BB3\u0BCD\u0BB5\u0BC0\u0BB0\u0BCD\u0B95\u0BB3\u0BCD,
    \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0BAA\u0BCD\u0BAA\u0BBE\u0BA9 \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
    \u0BA8\u0BAE\u0BCD\u0BAA\u0B95\u0BAE\u0BBE\u0BA9 \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BBF\u0BB1\u0BCD\u0B95\u0BC1\u0BA4\u0BCD
    \u0BA4\u0BC7\u0BB5\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAE\u0BC1\u0B95\u0BCD\u0B95\u0BBF\u0BAF
    \u0B86\u0BAF\u0BCD\u0BB5\u0BC1 \u0B95\u0BBE\u0B9A\u0BCB\u0BB2\u0BC8\u0B95\u0BB3\u0BC8\u0B95\u0BCD
    \u0B95\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BCA\u0BB3\u0BCD\u0BB5\u0BC0\u0BB0\u0BCD\u0B95\u0BB3\u0BCD."
  m_FontAsset_TSCII: {fileID: 11400000, guid: da6f40bea57120f459953f44f8278839, type: 2}
