--- !u!114 &5116805086440137510
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4396748567694783530}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Next, take Seal S1 and attach it carefully on the inner ring side where
      the first ball cage assembly is positioned to ensure proper grip and secure
      seating. Make sure the seal is evenly aligned and properly seated without twisting.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1, Seal S1-\u0B90 \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1
      \u0BAE\u0BC1\u0BA4\u0BB2\u0BCD \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1 \u0B95\u0BC7\u0B9C\u0BCD
      \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BC1\u0BB3\u0BCD\u0BB3
      \u0B87\u0BA9\u0BCD\u0B9F\u0BB0\u0BCD \u0BB0\u0BBF\u0B99\u0BCD \u0BAA\u0B95\u0BCD\u0B95\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD
      \u0B95\u0BB5\u0BA9\u0BAE\u0BBE\u0B95 \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD,
      \u0B87\u0BA4\u0BC1 \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0BAA\u0BBF\u0B9F\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0BAA\u0BCD\u0BAA\u0BBE\u0BA9
      \u0B85\u0BAE\u0BB0\u0BCD\u0BB5\u0BC8 \u0BB5\u0BB4\u0B99\u0BCD\u0B95\u0BC1\u0BAE\u0BCD.
      \u0B9A\u0BC0\u0BB2\u0BCD \u0B9A\u0BC1\u0BB0\u0BC1\u0BA3\u0BCD\u0B9F\u0BC1 \u0BAA\u0BCB\u0B95\u0BBE\u0BAE\u0BB2\u0BCD
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0BAE\u0BAE\u0BBE\u0B95 \u0B85\u0BAE\u0BB0\u0BCD\u0BA8\u0BCD\u0BA4\u0BC1\u0BB3\u0BCD\u0BB3\u0BA4\u0BBE
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0907\u0938\u0915\u0947 \u092C\u093E\u0926, Seal S1 \u0915\u094B \u0932\u0947\u0902
      \u0914\u0930 \u0909\u0938\u0947 \u0907\u0928\u0930 \u0930\u093F\u0902\u0917
      \u0915\u0940 \u0909\u0938 \u0938\u093E\u0907\u0921 \u092A\u0930 \u0938\u093E\u0935\u0927\u093E\u0928\u0940\u092A\u0942\u0930\u094D\u0935\u0915
      \u0932\u0917\u093E\u090F\u0901 \u091C\u0939\u093E\u0901 \u092A\u0939\u0932\u0940
      \u092C\u0949\u0932 \u0915\u0947\u091C \u0905\u0938\u0947\u0902\u092C\u0932\u0940
      \u0938\u094D\u0925\u093F\u0924 \u0939\u0948, \u0924\u093E\u0915\u093F \u0938\u0939\u0940
      \u092A\u0915\u0921\u093C \u0914\u0930 \u0938\u0941\u0930\u0915\u094D\u0937\u093F\u0924
      \u092B\u093F\u091F\u093F\u0902\u0917 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0939\u094B \u0938\u0915\u0947\u0964 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0915\u0930\u0947\u0902 \u0915\u093F \u0938\u0940\u0932 \u0938\u092E\u093E\u0928
      \u0930\u0942\u092A \u0938\u0947 \u092C\u0948\u0920\u0940 \u0939\u094B \u0914\u0930
      \u092E\u0941\u0921\u093C\u0940 \u092F\u093E \u091F\u0947\u0922\u093C\u0940
      \u0928 \u0939\u094B\u0964"
    Object: {fileID: 0}
