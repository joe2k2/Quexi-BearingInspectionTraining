  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: To support higher loads and improve stability
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0BA4\u0BBF\u0B95 \u0B9A\u0BC1\u0BAE\u0BC8\u0B95\u0BB3\u0BC8 \u0B86\u0BA4\u0BB0\u0BBF\u0B95\u0BCD\u0B95
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BC8
      \u0BAE\u0BC7\u0BAE\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0909\u091A\u094D\u091A \u092D\u093E\u0930 \u0915\u093E \u0938\u092E\u0930\u094D\u0925\u0928
      \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u094D\u0925\u093F\u0930\u0924\u093E
      \u092E\u0947\u0902 \u0938\u0941\u0927\u093E\u0930 \u0915\u0930\u0928\u0947
      \u0915\u0947 \u0932\u093F\u090F"
    Object: {fileID: 0}
