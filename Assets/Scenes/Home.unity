  m_GameObject: {fileID: 7616668765529770448}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Now, carefully place this ball cage assembly onto the inner ring and align
      it correctly.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B87\u0BAA\u0BCD\u0BAA\u0BCB\u0BA4\u0BC1, \u0B87\u0BA8\u0BCD\u0BA4 \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1
      \u0B95\u0BC7\u0B9C\u0BCD \u0BA4\u0BCA\u0B95\u0BC1\u0BA4\u0BBF\u0BAF\u0BC8 \u0B89\u0BB3\u0BCD
      \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BA9\u0BCD \u0BAE\u0BC0\u0BA4\u0BC1
      \u0B95\u0BB5\u0BA9\u0BAE\u0BBE\u0B95 \u0BB5\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1 \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95
      \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BC1\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0905\u092C, \u0907\u0938 \u092C\u0949\u0932 \u0915\u0947\u091C \u0905\u0938\u0947\u0902\u092C\u0932\u0940
      \u0915\u094B \u0938\u093E\u0935\u0927\u093E\u0928\u0940\u092A\u0942\u0930\u094D\u0935\u0915
      \u0907\u0928\u0930 \u0930\u093F\u0902\u0917 \u092A\u0930 \u0930\u0916\u0947\u0902
      \u0914\u0930 \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947
      \u0938\u0902\u0930\u0947\u0916\u093F\u0924 \u0915\u0930\u0947\u0902\u0964"
    Object: {fileID: 0}
