  entries:
  - Language: English
    Text: Which component maintains equal spacing between the balls?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1
      \u0B87\u0B9F\u0BC8\u0BAF\u0BC7 \u0B9A\u0BAE\u0BAE\u0BBE\u0BA9 \u0B87\u0B9F\u0BC8\u0BB5\u0BC6\u0BB3\u0BBF\u0BAF\u0BC8
      \u0BAA\u0BB0\u0BBE\u0BAE\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0B95\u0BC2\u0BB1\u0BC1
      \u0B8E\u0BA4\u0BC1?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0915\u094C\u0928 \u0938\u093E \u0918\u091F\u0915 \u0917\u0947\u0902\u0926\u094B\u0902
      \u0915\u0947 \u092C\u0940\u091A \u0938\u092E\u093E\u0928 \u0926\u0942\u0930\u0940
      \u092C\u0928\u093E\u090F \u0930\u0916\u0924\u093E \u0939\u0948?"
    Object: {fileID: 0}
