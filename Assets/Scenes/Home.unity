--- !u!114 &1018159629485675598
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4486252308877391861}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Now, take the outer ring and gently place it over the ball cage and inner
      ring assembly.

      Press the outer ring slowly until all parts are fully
      seated and aligned.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B87\u0BAA\u0BCD\u0BAA\u0BCB\u0BA4\u0BC1, \u0BB5\u0BC6\u0BB3\u0BBF \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BC8
      (Outer Ring) \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1, \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1
      \u0B95\u0BC7\u0B9C\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B89\u0BB3\u0BCD
      \u0BB5\u0BB3\u0BC8\u0BAF\u0BAE\u0BCD \u0B85\u0BAE\u0BC8\u0B95\u0BCD\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F
      \u0BA4\u0BCA\u0B95\u0BC1\u0BA4\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD \u0BAE\u0BC0\u0BA4\u0BC1
      \u0BAE\u0BC6\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0BB5\u0BC8\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD.\n\u0B85\u0BA9\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1
      \u0BAA\u0B95\u0BC1\u0BA4\u0BBF\u0B95\u0BB3\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BB4\u0BC1\u0BAE\u0BC8\u0BAF\u0BBE\u0B95
      \u0B85\u0BAE\u0BB0\u0BC1\u0BAE\u0BCD \u0BB5\u0BB0\u0BC8 \u0BB5\u0BC6\u0BB3\u0BBF
      \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BC8 \u0BAE\u0BC6\u0BA4\u0BC1\u0BB5\u0BBE\u0B95
      \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0905\u092C, \u0906\u0909\u091F\u0930 \u0930\u093F\u0902\u0917 (Outer
      Ring) \u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947 \u092C\u0949\u0932
      \u0915\u0947\u091C \u0914\u0930 \u0907\u0928\u0930 \u0930\u093F\u0902\u0917
      \u0915\u0940 \u0905\u0938\u0947\u0902\u092C\u0932\u0940 \u0915\u0947 \u090A\u092A\u0930
      \u0927\u0940\u0930\u0947 \u0938\u0947 \u0930\u0916\u0947\u0902\u0964\n\u0938\u092D\u0940
      \u0939\u093F\u0938\u094D\u0938\u0947 \u092A\u0942\u0930\u0940 \u0924\u0930\u0939
      \u0938\u0947 \u092C\u0948\u0920 \u091C\u093E\u090F\u0901, \u0907\u0938\u0915\u0947
      \u0932\u093F\u090F \u0906\u0909\u091F\u0930 \u0930\u093F\u0902\u0917 \u0915\u094B
      \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0926\u092C\u093E\u090F\u0901\u0964"
    Object: {fileID: 0}
--- !u!114 &1026847892454619140
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5975431136015182006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Next, position the  row of balls with the cages and make sure the balls
      are evenly spaced and properly seated inside the groove. Adjust the cage if
      necessary to achieve proper alignment before proceeding.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1, \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1
      \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8\u0BAF\u0BC8 \u0B95\u0BC7\u0B9C\u0BCD\u0B95\u0BB3\u0BC1\u0B9F\u0BA9\u0BCD
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF, \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BCD
      \u0B9A\u0BAE\u0BAE\u0BBE\u0B95 \u0B87\u0B9F\u0BC8\u0BB5\u0BC6\u0BB3\u0BBF\u0BAF\u0BBF\u0BB2\u0BCD
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95 \u0B95\u0BC1\u0BB4\u0BBF\u0B95\u0BCD\u0B95\u0BC1\u0BB3\u0BCD
      \u0B85\u0BAE\u0BB0\u0BCD\u0BA8\u0BCD\u0BA4\u0BC1\u0BB3\u0BCD\u0BB3\u0BA9\u0BB5\u0BBE
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD.
      \u0BA4\u0BC7\u0BB5\u0BC8\u0BAF\u0BC6\u0BA9\u0BBF\u0BB2\u0BCD \u0B95\u0BC7\u0B9C\u0BBF\u0BA9\u0BCD
      \u0BA8\u0BBF\u0BB2\u0BC8\u0BAF\u0BC8 \u0B9A\u0BB0\u0BBF\u0B9A\u0BC6\u0BAF\u0BCD\u0BA4\u0BC1
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BC8
      \u0BAA\u0BC6\u0BB1\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0907\u0938\u0915\u0947 \u092C\u093E\u0926, \u092C\u0949\u0932\u094D\u0938
      \u0915\u0940 \u092A\u0902\u0915\u094D\u0924\u093F \u0915\u094B \u0915\u0947\u091C
      \u0915\u0947 \u0938\u093E\u0925 \u0938\u094D\u0925\u093E\u092A\u093F\u0924
      \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0915\u0930\u0947\u0902 \u0915\u093F \u0938\u092D\u0940 \u092C\u0949\u0932\u094D\u0938
      \u0938\u092E\u093E\u0928 \u0926\u0942\u0930\u0940 \u092A\u0930 \u0939\u094B\u0902
      \u0914\u0930 \u0917\u094D\u0930\u0942\u0935 \u0915\u0947 \u0905\u0902\u0926\u0930
      \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u092C\u0948\u0920\u0947
      \u0939\u094B\u0902\u0964 \u092F\u0926\u093F \u0906\u0935\u0936\u094D\u092F\u0915
      \u0939\u094B \u0924\u094B \u0915\u0947\u091C \u0915\u094B \u0938\u092E\u093E\u092F\u094B\u091C\u093F\u0924
      \u0915\u0930\u0915\u0947 \u0938\u0939\u0940 \u0938\u0902\u0930\u0947\u0916\u0923
      \u092A\u094D\u0930\u093E\u092A\u094D\u0924 \u0915\u0930\u0947\u0902\u0964"
    Object: {fileID: 0}
