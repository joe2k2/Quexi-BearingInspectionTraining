--- !u!114 &1800344060
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1800344058}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Bolts secure the Hub3 bearing assembly to the vehicle knuckle and ensure
      the unit remains firmly fixed during operation. They maintain structural stability,
      support load transfer, and prevent movement or misalignment while the wheel
      rotates.


      Check for: correct torque, no thread damage, no corrosion,
      no cracks, no bending, proper seating against the mounting surface, and no
      loosening.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BCB\u0BB2\u0BCD\u0B9F\u0BCD\u0B95\u0BB3\u0BCD \u0BB9\u0BAA\u0BCD3
      \u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF\u0BAF\u0BC8
      \u0BB5\u0BBE\u0B95\u0BA9\u0BA4\u0BCD\u0BA4\u0BBF\u0BA9\u0BCD \u0BA8\u0B95\u0BCD\u0B95\u0BBF\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1\u0BAA\u0BCD
      \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0BA4\u0BCD\u0BA4\u0BC1, \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BBF\u0BA9\u0BCD
      \u0BAA\u0BCB\u0BA4\u0BC1 \u0B85\u0BB2\u0B95\u0BC1 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF\u0BAF\u0BBE\u0B95
      \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BBF\u0BB0\u0BC1\u0BAA\u0BCD\u0BAA\u0BA4\u0BC8
      \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0B95\u0BBF\u0BA9\u0BCD\u0BB1\u0BA9.
      \u0B85\u0BB5\u0BC8 \u0B95\u0B9F\u0BCD\u0B9F\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1
      \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BC8
      \u0BAA\u0BB0\u0BBE\u0BAE\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BA9\u0BCD\u0BB1\u0BA9,
      \u0B9A\u0BC1\u0BAE\u0BC8 \u0BAA\u0BB0\u0BBF\u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BA4\u0BCD\u0BA4\u0BC8
      \u0B86\u0BA4\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BA9\u0BCD\u0BB1\u0BA9, \u0BAE\u0BC7\u0BB2\u0BC1\u0BAE\u0BCD
      \u0B9A\u0B95\u0BCD\u0B95\u0BB0\u0BAE\u0BCD \u0B9A\u0BC1\u0BB4\u0BB2\u0BC1\u0BAE\u0BCD
      \u0BAA\u0BCB\u0BA4\u0BC1 \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0BAE\u0BCD \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1
      \u0BA4\u0BB5\u0BB1\u0BBE\u0BA9 \u0B9A\u0BC0\u0BB0\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC8\u0BA4\u0BCD
      \u0BA4\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BBF\u0BA9\u0BCD\u0BB1\u0BA9. \n\u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95:
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0BAE\u0BC1\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BC1,
      \u0BA8\u0BC2\u0BB2\u0BCD \u0B9A\u0BC7\u0BA4\u0BAE\u0BCD, \u0B85\u0BB0\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0BB5\u0BB3\u0BC8\u0BB5\u0BC1 \u0B87\u0BB2\u0BCD\u0BB2\u0BC8,
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0B87\u0BB0\u0BC1\u0B95\u0BCD\u0B95\u0BC8
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA4\u0BB3\u0BB0\u0BCD\u0BB5\u0BC1
      \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BC1."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u094B\u0932\u094D\u091F \u0935\u093E\u0939\u0928 \u0915\u0947 \u092A\u094B\u0930
      \u092A\u0930 \u0939\u092C3 \u092C\u093F\u092F\u0930\u093F\u0902\u0917 \u0905\u0938\u0947\u0902\u092C\u0932\u0940
      \u0915\u094B \u0938\u0941\u0930\u0915\u094D\u0937\u093F\u0924 \u0915\u0930\u0924\u0947
      \u0939\u0948\u0902 \u0914\u0930 \u092F\u0939 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093F \u0911\u092A\u0930\u0947\u0936\u0928
      \u0915\u0947 \u0926\u094C\u0930\u093E\u0928 \u092F\u0942\u0928\u093F\u091F
      \u092E\u091C\u092C\u0942\u0924\u0940 \u0938\u0947 \u0938\u094D\u0925\u093F\u0930
      \u0930\u0939\u0947\u0964 \u0935\u0947 \u0938\u0902\u0930\u091A\u0928\u093E\u0924\u094D\u092E\u0915
      \u0938\u094D\u0925\u093F\u0930\u0924\u093E \u092C\u0928\u093E\u090F \u0930\u0916\u0924\u0947
      \u0939\u0948\u0902, \u0932\u094B\u0921 \u091F\u094D\u0930\u093E\u0902\u0938\u092B\u0930
      \u0915\u093E \u0938\u092E\u0930\u094D\u0925\u0928 \u0915\u0930\u0924\u0947
      \u0939\u0948\u0902, \u0914\u0930 \u092A\u0939\u093F\u092F\u093E \u0918\u0942\u092E\u0924\u0947
      \u0938\u092E\u092F \u0917\u0924\u093F \u092F\u093E \u0917\u0932\u0924 \u0938\u0902\u0930\u0947\u0916\u0923
      \u0915\u094B \u0930\u094B\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \n\n\u091C\u093E\u0901\u091A
      \u0915\u0930\u0947\u0902: \u0938\u0939\u0940 \u091F\u0949\u0930\u094D\u0915,
      \u0915\u094B\u0908 \u0927\u093E\u0917\u093E \u0915\u094D\u0937\u0924\u093F
      \u0928\u0939\u0940\u0902, \u0915\u094B\u0908 \u091C\u0902\u0917 \u0928\u0939\u0940\u0902,
      \u0915\u094B\u0908 \u0926\u0930\u093E\u0930 \u0928\u0939\u0940\u0902, \u0915\u094B\u0908
      \u091D\u0941\u0915\u0928\u093E \u0928\u0939\u0940\u0902, \u092C\u0922\u093C\u0924\u0947
      \u0938\u0924\u0939 \u0915\u0947 \u0916\u093F\u0932\u093E\u092B \u0909\u091A\u093F\u0924
      \u092C\u0948\u0920\u0928\u093E, \u0914\u0930 \u0915\u094B\u0908 \u0922\u0940\u0932\u093E\u092A\u0928
      \u0928\u0939\u0940\u0902\u0964"
    Object: {fileID: 0}
