--- !u!114 &1722873109
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1722873107}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Which component should be placed first during the assembly of a single
      row bearing?


      Grab the correct part and place it at the center.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B92\u0BB1\u0BCD\u0BB1\u0BC8 \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BC8
      \u0B87\u0BA3\u0BC8\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0BAA\u0BCB\u0BA4\u0BC1
      \u0B8E\u0BA8\u0BCD\u0BA4 \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BC8 \u0BAE\u0BC1\u0BA4\u0BB2\u0BBF\u0BB2\u0BCD
      \u0BB5\u0BC8\u0B95\u0BCD\u0B95 \u0BB5\u0BC7\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD?\n\n\u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0BAA\u0B95\u0BC1\u0BA4\u0BBF\u0BAF\u0BC8 \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1
      \u0BAE\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD \u0BB5\u0BC8\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u090F\u0915\u0932 \u092A\u0902\u0915\u094D\u0924\u093F \u092C\u093F\u092F\u0930\u093F\u0902\u0917
      \u0915\u0947 \u0938\u0902\u092F\u094B\u091C\u0928 \u0915\u0947 \u0926\u094C\u0930\u093E\u0928
      \u0915\u093F\u0938 \u0918\u091F\u0915 \u0915\u094B \u092A\u0939\u0932\u0947
      \u0930\u0916\u093E \u091C\u093E\u0928\u093E \u091A\u093E\u0939\u093F\u090F?\n\n\u0938\u0939\u0940
      \u092D\u093E\u0917 \u0915\u094B \u092A\u0915\u0921\u093C\u0947\u0902 \u0914\u0930
      \u0907\u0938\u0947 \u0915\u0947\u0902\u0926\u094D\u0930 \u092E\u0947\u0902
      \u0930\u0916\u0947\u0902\u0964"
    Object: {fileID: 0}
