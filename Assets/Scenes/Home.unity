MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6267205882650394994}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Then, place the seal carefully to lock the bearing assembly in position.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BBF\u0BB1\u0B95\u0BC1, \u0B9A\u0BC0\u0BB2\u0BC8 (Seal) \u0B95\u0BB5\u0BA9\u0BAE\u0BBE\u0B95
      \u0BB5\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1, \u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD
      \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF\u0BAF\u0BBE\u0B95\u0BAA\u0BCD
      \u0BAA\u0BC2\u0B9F\u0BCD\u0B9F\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092B\u093F\u0930, \u0938\u0940\u0932 (Seal) \u0915\u094B \u0938\u093E\u0935\u0927\u093E\u0928\u0940\u092A\u0942\u0930\u094D\u0935\u0915
      \u0932\u0917\u093E\u090F\u0901 \u0924\u093E\u0915\u093F \u092C\u0947\u092F\u0930\u093F\u0902\u0917
      \u0905\u0938\u0947\u0902\u092C\u0932\u0940 \u0938\u0939\u0940 \u0938\u094D\u0925\u093F\u0924\u093F
      \u092E\u0947\u0902 \u0932\u0949\u0915 \u0939\u094B \u091C\u093E\u090F\u0964"
    Object: {fileID: 0}
