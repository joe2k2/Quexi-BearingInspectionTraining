--- !u!114 &9062821589036582712
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7007602725440593274}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "Seal S1 protects the bearing from external contaminants while retaining
      lubrication inside the hub. \n\nCheck for: correct seating, no tears, no grease
      leakage, and intact sealing lip."
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B9A\u0BC0\u0BB2\u0BCD S1, \u0BB9\u0BAA\u0BCD\u0BAA\u0BBF\u0BA9\u0BCD
      \u0B89\u0BB3\u0BCD\u0BB3\u0BC7 \u0BB2\u0BC2\u0BAA\u0BCD\u0BB0\u0BBF\u0B95\u0BC7\u0BB7\u0BA9\u0BC8\u0BA4\u0BCD
      \u0BA4\u0B95\u0BCD\u0B95\u0BB5\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BCD\u0B95\u0BCA\u0BB3\u0BCD\u0BB3\u0BC1\u0BAE\u0BCD
      \u0BAA\u0BCB\u0BA4\u0BC1, \\u200b\\u200b\u0BB5\u0BC6\u0BB3\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1\u0BB1
      \u0B85\u0B9A\u0BC1\u0BA4\u0BCD\u0BA4\u0B99\u0BCD\u0B95\u0BB3\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1
      \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BC1\u0BA4\u0BB2\u0BC8\u0BAA\u0BCD \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \n\n\u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0B87\u0BB0\u0BC1\u0B95\u0BCD\u0B95\u0BC8,
      \u0B95\u0BA3\u0BCD\u0BA3\u0BC0\u0BB0\u0BCD \u0B87\u0BB2\u0BCD\u0BB2\u0BC8,
      \u0B95\u0BBF\u0BB0\u0BC0\u0BB8\u0BCD \u0B95\u0B9A\u0BBF\u0BB5\u0BC1 \u0B87\u0BB2\u0BCD\u0BB2\u0BC8,
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B85\u0BAA\u0BCD\u0BAA\u0B9F\u0BBF\u0BAF\u0BC7
      \u0B9A\u0BC0\u0BB2\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BC1\u0BAE\u0BCD \u0B89\u0BA4\u0B9F\u0BC1
      \u0B86\u0B95\u0BBF\u0BAF\u0BB5\u0BB1\u0BCD\u0BB1\u0BC8\u0B9A\u0BCD \u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0938\u0940\u0932 \u090F\u09381 \u0939\u092C \u0915\u0947 \u0905\u0902\u0926\u0930
      \u091A\u093F\u0915\u0928\u093E\u0908 \u092C\u0928\u093E\u090F \u0930\u0916\u0924\u0947
      \u0939\u0941\u090F \u092C\u093E\u0939\u0930\u0940 \u0938\u0902\u0926\u0942\u0937\u0915\u094B\u0902
      \u0938\u0947 \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u0940 \u0930\u0915\u094D\u0937\u093E
      \u0915\u0930\u0924\u093E \u0939\u0948\u0964 \n\n\u091C\u093E\u0901\u091A \u0915\u0930\u0947\u0902:
      \u0938\u0939\u0940 \u092C\u0948\u0920\u0928\u0947 \u0915\u0940 \u091C\u0917\u0939,
      \u0915\u094B\u0908 \u0926\u0930\u093E\u0930 \u0928\u0939\u0940\u0902, \u0915\u094B\u0908
      \u0917\u094D\u0930\u0940\u0938 \u0930\u093F\u0938\u093E\u0935 \u0928\u0939\u0940\u0902,
      \u0914\u0930 \u092C\u0930\u0915\u0930\u093E\u0930 \u0938\u0940\u0932\u093F\u0902\u0917
      \u0932\u093F\u092A\u0964"
    Object: {fileID: 0}
