--- !u!114 &9027792388750204706
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6819641005047623253}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What is the main function of a single row bearing?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B92\u0BB1\u0BCD\u0BB1\u0BC8 \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD
      \u0BAE\u0BC1\u0B95\u0BCD\u0B95\u0BBF\u0BAF \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BC1
      \u0B8E\u0BA9\u0BCD\u0BA9?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u090F\u0915\u0932 \u092A\u0902\u0915\u094D\u0924\u093F \u092C\u093F\u092F\u0930\u093F\u0902\u0917
      \u0915\u093E \u092E\u0941\u0916\u094D\u092F \u0915\u093E\u0930\u094D\u092F
      \u0915\u094D\u092F\u093E \u0939\u0948?"
    Object: {fileID: 0}
