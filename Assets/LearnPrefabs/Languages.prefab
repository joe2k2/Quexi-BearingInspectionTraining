--- !u!114 &4395419644509350167
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5440643235521524298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "The B1 ring connects the bearing to the wheel hub and transfers load from
      the wheel to the bearing assembly. \n\nCheck for: correct dimensions, smooth
      contact surface, no cracks, no wear marks, and proper press fit."
    Object: {fileID: 0}
  - Language: Tamil
    Text: "B1 \u0BB5\u0BB3\u0BC8\u0BAF\u0BAE\u0BCD \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BC8
      \u0BB5\u0BC0\u0BB2\u0BCD \u0BB9\u0BAA\u0BCD\u0BAA\u0BC1\u0B9F\u0BA9\u0BCD \u0B87\u0BA3\u0BC8\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0B95\u0BCD\u0B95\u0BB0\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1
      \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF\u0B95\u0BCD\u0B95\u0BC1
      \u0B9A\u0BC1\u0BAE\u0BC8\u0B95\u0BB3\u0BC8 \u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.\n\n\u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD:
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0BAA\u0BB0\u0BBF\u0BAE\u0BBE\u0BA3\u0B99\u0BCD\u0B95\u0BB3\u0BCD,
      \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0BA4\u0BCA\u0B9F\u0BB0\u0BCD\u0BAA\u0BC1
      \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BC1, \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD\u0B95\u0BB3\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0B89\u0B9F\u0BC8\u0B95\u0BB3\u0BCD \u0B87\u0BB2\u0BCD\u0BB2\u0BC8,
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4 \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u09401 \u0930\u093F\u0902\u0917 \u092C\u0947\u092F\u0930\u093F\u0902\u0917
      \u0915\u094B \u0935\u094D\u0939\u0940\u0932 \u0939\u092C \u0938\u0947 \u091C\u094B\u0921\u093C\u0924\u0940
      \u0939\u0948 \u0914\u0930 \u0935\u094D\u0939\u0940\u0932 \u0938\u0947 \u0932\u094B\u0921
      \u0915\u094B \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0905\u0938\u0947\u0902\u092C\u0932\u0940
      \u092E\u0947\u0902 \u0938\u094D\u0925\u093E\u0928\u093E\u0902\u0924\u0930\u093F\u0924
      \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \n\n\u0907\u0938\u0915\u0940 \u091C\u093E\u0902\u091A
      \u0915\u0930\u0947\u0902: \u0938\u0939\u0940 \u0906\u092F\u093E\u092E, \u091A\u093F\u0915\u0928\u0940
      \u0938\u0902\u092A\u0930\u094D\u0915 \u0938\u0924\u0939, \u0915\u094B\u0908
      \u0926\u0930\u093E\u0930 \u0928\u0939\u0940\u0902, \u0915\u094B\u0908 \u0918\u093F\u0938\u093E\u0935
      \u0915\u093E \u0928\u093F\u0936\u093E\u0928 \u0928\u0939\u0940\u0902 \u0914\u0930
      \u0909\u091A\u093F\u0924 \u092A\u094D\u0930\u0947\u0938 \u092B\u093F\u091F\u0964"
    Object: {fileID: 0}
