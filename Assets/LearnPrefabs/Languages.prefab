--- !u!114 &6507323346772846837
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3472769956590525603}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'The seal retains grease inside the bearing and prevents dust, water, and
      other contaminants from entering. It helps increase bearing life and reliability.


      Check
      for: proper seating, no damage or tears, correct alignment, and no grease leakage.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B87\u0BA8\u0BCD\u0BA4 \u0B9A\u0BC0\u0BB2\u0BCD, \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD
      \u0B89\u0BB3\u0BCD\u0BB3\u0BC7 \u0B95\u0BBF\u0BB0\u0BC0\u0BB8\u0BC8\u0BA4\u0BCD
      \u0BA4\u0B95\u0BCD\u0B95\u0BB5\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1, \u0BA4\u0BC2\u0B9A\u0BBF,
      \u0BA8\u0BC0\u0BB0\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAA\u0BBF\u0BB1
      \u0B85\u0B9A\u0BC1\u0BA4\u0BCD\u0BA4\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0B89\u0BB3\u0BCD\u0BB3\u0BC7
      \u0BA8\u0BC1\u0BB4\u0BC8\u0BB5\u0BA4\u0BC8\u0BA4\u0BCD \u0BA4\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \u0B87\u0BA4\u0BC1 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD
      \u0B86\u0BAF\u0BC1\u0BB3\u0BC8\u0BAF\u0BC1\u0BAE\u0BCD \u0BA8\u0BAE\u0BCD\u0BAA\u0B95\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BC8\u0BAF\u0BC1\u0BAE\u0BCD
      \u0B85\u0BA4\u0BBF\u0B95\u0BB0\u0BBF\u0B95\u0BCD\u0B95 \u0B89\u0BA4\u0BB5\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.\r\n\r\n\u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0B87\u0BB0\u0BC1\u0B95\u0BCD\u0B95\u0BC8, \u0B9A\u0BC7\u0BA4\u0BAE\u0BCD
      \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0B95\u0BBF\u0BB4\u0BBF\u0BB5\u0BC1\u0B95\u0BB3\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0B9A\u0BC0\u0BB0\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B95\u0BBF\u0BB0\u0BC0\u0BB8\u0BCD
      \u0B95\u0B9A\u0BBF\u0BB5\u0BC1 \u0B87\u0BB2\u0BCD\u0BB2\u0BC8 \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8\u0B9A\u0BCD
      \u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0938\u0940\u0932 \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u0947
      \u0905\u0902\u0926\u0930 \u0917\u094D\u0930\u0940\u0938 \u0915\u094B \u0930\u094B\u0915\u0915\u0930
      \u0930\u0916\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0927\u0942\u0932, \u092A\u093E\u0928\u0940
      \u0914\u0930 \u0905\u0928\u094D\u092F \u0926\u0942\u0937\u093F\u0924 \u092A\u0926\u093E\u0930\u094D\u0925\u094B\u0902
      \u0915\u094B \u0905\u0902\u0926\u0930 \u091C\u093E\u0928\u0947 \u0938\u0947
      \u092C\u091A\u093E\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938\u0938\u0947
      \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u093E \u091C\u0940\u0935\u0928\u0915\u093E\u0932
      \u0914\u0930 \u0935\u093F\u0936\u094D\u0935\u0938\u0928\u0940\u092F\u0924\u093E
      \u092C\u0922\u093C\u0924\u0940 \u0939\u0948\u0964\r\n\r\n\u0907\u0928 \u092C\u093E\u0924\u094B\u0902
      \u0915\u0940 \u091C\u093E\u0901\u091A \u0915\u0930\u0947\u0902: \u0938\u0939\u0940
      \u0938\u0940\u091F\u093F\u0902\u0917, \u0915\u094B\u0908 \u0915\u094D\u0937\u0924\u093F
      \u092F\u093E \u0926\u0930\u093E\u0930 \u0928\u0939\u0940\u0902, \u0938\u0939\u0940
      \u0905\u0932\u093E\u0907\u0928\u092E\u0947\u0902\u091F \u0914\u0930 \u0917\u094D\u0930\u0940\u0938
      \u0915\u093E \u0930\u093F\u0938\u093E\u0935 \u0928\u0939\u0940\u0902\u0964"
    Object: {fileID: 0}
