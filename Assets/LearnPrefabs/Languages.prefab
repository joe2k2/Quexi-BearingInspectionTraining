--- !u!114 &3324477094904552014
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1674564141890669850}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Then, take the outer ring and gently place it over the assembled set.

      Press
      the outer ring slowly until all parts are fully seated and aligned.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BBF\u0BB1\u0B95\u0BC1, \u0BB5\u0BC6\u0BB3\u0BBF \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BC8
      (Outer Ring) \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1, \u0B85\u0BAE\u0BC8\u0B95\u0BCD\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F
      \u0BA4\u0BCA\u0B95\u0BC1\u0BA4\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD \u0BAE\u0BC0\u0BA4\u0BC1
      \u0BAE\u0BC6\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0BB5\u0BC8\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD.\n\u0B85\u0BA9\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1
      \u0BAA\u0B95\u0BC1\u0BA4\u0BBF\u0B95\u0BB3\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BB4\u0BC1\u0BAE\u0BC8\u0BAF\u0BBE\u0B95
      \u0B85\u0BAE\u0BB0\u0BC1\u0BAE\u0BCD \u0BB5\u0BB0\u0BC8 \u0BB5\u0BC6\u0BB3\u0BBF
      \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BC8 \u0BAE\u0BC6\u0BA4\u0BC1\u0BB5\u0BBE\u0B95
      \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD.\n"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092B\u093F\u0930, \u0906\u0909\u091F\u0930 \u0930\u093F\u0902\u0917
      (Outer Ring) \u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947 \u0924\u0948\u092F\u093E\u0930
      \u0915\u093F\u090F \u0917\u090F \u0938\u0947\u091F \u0915\u0947 \u090A\u092A\u0930
      \u0927\u0940\u0930\u0947 \u0938\u0947 \u0930\u0916\u0947\u0902\u0964\n\u0938\u092D\u0940
      \u0939\u093F\u0938\u094D\u0938\u0947 \u092A\u0942\u0930\u0940 \u0924\u0930\u0939
      \u0938\u0947 \u092C\u0948\u0920 \u091C\u093E\u090F\u0901, \u0907\u0938\u0915\u0947
      \u0932\u093F\u090F \u0906\u0909\u091F\u0930 \u0930\u093F\u0902\u0917 \u0915\u094B
      \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0926\u092C\u093E\u090F\u0901\u0964"
    Object: {fileID: 0}
