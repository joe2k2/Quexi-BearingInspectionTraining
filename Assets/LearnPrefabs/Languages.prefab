  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What is a key inspection point for a plastic cage?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BBF\u0BB3\u0BBE\u0BB8\u0BCD\u0B9F\u0BBF\u0B95\u0BCD \u0B95\u0BC2\u0BA3\u0BCD\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BBE\u0BA9
      \u0BAE\u0BC1\u0B95\u0BCD\u0B95\u0BBF\u0BAF \u0B86\u0BAF\u0BCD\u0BB5\u0BC1\u0BAA\u0BCD
      \u0BAA\u0BC1\u0BB3\u0BCD\u0BB3\u0BBF \u0B8E\u0BA9\u0BCD\u0BA9?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u090F\u0915\u0932 \u092A\u0902\u0915\u094D\u0924\u093F \u092C\u093F\u092F\u0930\u093F\u0902\u0917
      \u0915\u093E \u092E\u0941\u0916\u094D\u092F \u0915\u093E\u0930\u094D\u092F
      \u0915\u094D\u092F\u093E \u0939\u0948?"
    Object: {fileID: 0}
