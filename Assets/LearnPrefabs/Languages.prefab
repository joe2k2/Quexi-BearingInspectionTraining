--- !u!114 &4115670395962781393
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1921809965706979632}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'The inner ring is mounted on the shaft and rotates with it.It transfers
      the load from the shaft to the rolling elements and maintains proper alignment.


      Check
      for: correct bore size, proper shaft fit, smooth raceway, no cracks, no burrs,
      and no heat or discoloration marks.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B89\u0BB3\u0BCD \u0BB5\u0BB3\u0BC8\u0BAF\u0BAE\u0BCD \u0BA4\u0BA3\u0BCD\u0B9F\u0BBF\u0BB2\u0BCD
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BC1
      \u0B85\u0BA4\u0BA9\u0BC1\u0B9F\u0BA9\u0BCD \u0B9A\u0BC1\u0BB4\u0BB2\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \u0B87\u0BA4\u0BC1 \u0BA4\u0BA3\u0BCD\u0B9F\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1
      \u0B9A\u0BC1\u0BAE\u0BC8\u0BAF\u0BC8 \u0B89\u0BB0\u0BC1\u0BB3\u0BC1\u0BAE\u0BCD
      \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1 \u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0B9A\u0BC0\u0BB0\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC8\u0BAA\u0BCD \u0BAA\u0BB0\u0BBE\u0BAE\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.\r\n\r\n\u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0BA4\u0BC1\u0BB3\u0BC8 \u0B85\u0BB3\u0BB5\u0BC1, \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0BA4\u0BA3\u0BCD\u0B9F\u0BC1 \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BAE\u0BCD,
      \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAA\u0BA8\u0BCD\u0BA4\u0BAF\u0BAA\u0BCD
      \u0BAA\u0BBE\u0BA4\u0BC8, \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD\u0B95\u0BB3\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0BAA\u0BB0\u0BCD\u0BB0\u0BCD\u0B95\u0BB3\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BB5\u0BC6\u0BAA\u0BCD\u0BAA\u0BAE\u0BCD \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1
      \u0BA8\u0BBF\u0BB1\u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0B95\u0BCD \u0B95\u0BC1\u0BB1\u0BBF\u0B95\u0BB3\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8 \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8\u0B9A\u0BCD
      \u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092D\u0940\u0924\u0930\u0940 \u0935\u0932\u092F \u0936\u093E\u092B\u094D\u091F
      \u092A\u0930 \u0932\u0917\u093E \u0939\u094B\u0924\u093E \u0939\u0948 \u0914\u0930
      \u0909\u0938\u0915\u0947 \u0938\u093E\u0925 \u0918\u0942\u092E\u0924\u093E
      \u0939\u0948\u0964 \u092F\u0939 \u0936\u093E\u092B\u094D\u091F \u0938\u0947
      \u0930\u094B\u0932\u093F\u0902\u0917 \u0924\u0924\u094D\u0935\u094B\u0902 \u0924\u0915
      \u092D\u093E\u0930 \u0938\u094D\u0925\u093E\u0928\u093E\u0902\u0924\u0930\u093F\u0924
      \u0915\u0930\u0924\u093E \u0939\u0948 \u0914\u0930 \u0909\u091A\u093F\u0924
      \u0938\u0902\u0930\u0947\u0916\u0923 \u092C\u0928\u093E\u090F \u0930\u0916\u0924\u093E
      \u0939\u0948\u0964\r\n\r\n\u0928\u093F\u092E\u094D\u0928\u0932\u093F\u0916\u093F\u0924
      \u0915\u0940 \u091C\u093E\u0901\u091A \u0915\u0930\u0947\u0902: \u0938\u0939\u0940
      \u092C\u094B\u0930 \u0906\u0915\u093E\u0930, \u0936\u093E\u092B\u094D\u091F
      \u0915\u0940 \u0909\u091A\u093F\u0924 \u092B\u093F\u091F\u093F\u0902\u0917,
      \u091A\u093F\u0915\u0928\u0940 \u0930\u0947\u0938\u0935\u0947, \u0915\u094B\u0908
      \u0926\u0930\u093E\u0930 \u0928\u0939\u0940\u0902, \u0915\u094B\u0908 \u0916\u0941\u0930\u0926\u0930\u093E\u092A\u0928
      \u0928\u0939\u0940\u0902, \u0914\u0930 \u0915\u094B\u0908 \u0924\u093E\u092A
      \u092F\u093E \u0930\u0902\u0917 \u092A\u0930\u093F\u0935\u0930\u094D\u0924\u0928
      \u0915\u0947 \u0928\u093F\u0936\u093E\u0928 \u0928\u0939\u0940\u0902\u0964"
    Object: {fileID: 0}
