  data: 0
  entries:
  - Language: English
    Text: Integrated hub, bearing, and mounting components
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B92\u0BB0\u0BC1\u0B99\u0BCD\u0B95\u0BBF\u0BA3\u0BC8\u0BA8\u0BCD\u0BA4
      \u0BB9\u0BAA\u0BCD, \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BAE\u0BB5\u0BC1\u0BA3\u0BCD\u0B9F\u0BBF\u0B99\u0BCD \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BCD"
