  entries:
  - Language: English
    Text: Corrosion due to moisture entry
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B88\u0BB0\u0BAA\u0BCD\u0BAA\u0BA4\u0BAE\u0BCD \u0BA8\u0BC1\u0BB4\u0BC8\u0BB5\u0BA4\u0BBE\u0BB2\u0BCD
      \u0B85\u0BB0\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0928\u092E\u0940 \u092A\u094D\u0930\u0935\u0947\u0936 \u0915\u0947 \u0915\u093E\u0930\u0923
      \u0938\u0902\u0915\u094D\u0937\u093E\u0930\u0923"
    Object: {fileID: 0}
