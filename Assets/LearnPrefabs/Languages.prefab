  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Surface pitting on balls or raceway
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BCD \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1
      \u0BB0\u0BC7\u0BB8\u0BCD\u0BB5\u0BC7\u0BAF\u0BBF\u0BB2\u0BCD \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BC1
      \u0BAA\u0BBF\u0B9F\u0BCD\u0B9F\u0BBF\u0B99\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0917\u0947\u0902\u0926\u094B\u0902 \u092F\u093E \u0930\u0947\u0938\u0935\u0947
      \u092A\u0930 \u0938\u0924\u0939 \u092A\u0930 \u0917\u0921\u094D\u0922\u093E
      \u0915\u0930\u0928\u093E"
    Object: {fileID: 0}
