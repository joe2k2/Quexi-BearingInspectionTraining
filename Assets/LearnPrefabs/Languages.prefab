--- !u!114 &1625490415737038286
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8440051813703293068}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "The metal cage maintains equal spacing between the balls and guides their
      motion during rotation. It improves bearing stability under higher speeds and
      temperatures. \n\nCheck for: deformation, cracks, wear marks, secure ball retention,
      and no corrosion."
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B89\u0BB2\u0BCB\u0B95\u0B95\u0BCD \u0B95\u0BC2\u0BA3\u0BCD\u0B9F\u0BC1
      \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1 \u0B87\u0B9F\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD
      \u0B9A\u0BAE\u0BAE\u0BBE\u0BA9 \u0B87\u0B9F\u0BC8\u0BB5\u0BC6\u0BB3\u0BBF\u0BAF\u0BC8\u0BAA\u0BCD
      \u0BAA\u0BB0\u0BBE\u0BAE\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0B9A\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD
      \u0BAA\u0BCB\u0BA4\u0BC1 \u0B85\u0BB5\u0BB1\u0BCD\u0BB1\u0BBF\u0BA9\u0BCD \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0BA4\u0BCD\u0BA4\u0BC8
      \u0BB5\u0BB4\u0BBF\u0BA8\u0B9F\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \u0B87\u0BA4\u0BC1 \u0B85\u0BA4\u0BBF\u0B95 \u0BB5\u0BC7\u0B95\u0BAE\u0BCD
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BB5\u0BC6\u0BAA\u0BCD\u0BAA\u0BA8\u0BBF\u0BB2\u0BC8\u0BAF\u0BBF\u0BA9\u0BCD
      \u0B95\u0BC0\u0BB4\u0BCD \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BC8
      \u0BAE\u0BC7\u0BAE\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \u0B9A\u0BBF\u0BA4\u0BC8\u0BB5\u0BC1, \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD,
      \u0B85\u0BA3\u0BBF\u0BAF \u0BAE\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0BC6\u0BA3\u0BCD\u0B95\u0BB3\u0BCD,
      \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0BAA\u0BCD\u0BAA\u0BBE\u0BA9 \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1
      \u0BA4\u0B95\u0BCD\u0B95\u0BB5\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1 \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0B85\u0BB0\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1 \u0B87\u0BB2\u0BCD\u0BB2\u0BC8."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0927\u093E\u0924\u0941 \u0915\u093E \u092A\u093F\u0902\u091C\u0930\u093E
      \u0917\u0947\u0902\u0926\u094B\u0902 \u0915\u0947 \u092C\u0940\u091A \u0938\u092E\u093E\u0928
      \u0926\u0942\u0930\u0940 \u092C\u0928\u093E\u090F \u0930\u0916\u0924\u093E
      \u0939\u0948 \u0914\u0930 \u0930\u094B\u091F\u0947\u0936\u0928 \u0915\u0947
      \u0926\u094C\u0930\u093E\u0928 \u0909\u0928\u0915\u0940 \u0917\u0924\u093F
      \u0915\u094B \u0928\u093F\u0930\u094D\u0926\u0947\u0936\u093F\u0924 \u0915\u0930\u0924\u093E
      \u0939\u0948\u0964 \u092F\u0939 \u0909\u091A\u094D\u091A \u0917\u0924\u093F
      \u0914\u0930 \u0924\u093E\u092A\u092E\u093E\u0928 \u0915\u0947 \u0924\u0939\u0924
      \u0905\u0938\u0930 \u0938\u094D\u0925\u093F\u0930\u0924\u093E \u092E\u0947\u0902
      \u0938\u0941\u0927\u093E\u0930 \u0915\u0930\u0924\u093E \u0939\u0948\u0964
      \u091C\u093E\u0901\u091A \u0915\u0930\u0947\u0902: \u0935\u093F\u0930\u0942\u092A\u0923,
      \u0926\u0930\u093E\u0930\u0947\u0902, \u0918\u093F\u0938\u093E\u0935 \u0915\u0947
      \u0928\u093F\u0936\u093E\u0928, \u0938\u0941\u0930\u0915\u094D\u0937\u093F\u0924
      \u0917\u0947\u0902\u0926 \u092A\u094D\u0930\u0924\u093F\u0927\u093E\u0930\u0923,
      \u0914\u0930 \u0915\u094B\u0908 \u091C\u0902\u0917 \u0928\u0939\u0940\u0902\u0964"
    Object: {fileID: 0}
