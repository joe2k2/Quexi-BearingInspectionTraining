  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What should be checked on the metal cage during inspection?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B86\u0BAF\u0BCD\u0BB5\u0BBF\u0BA9\u0BCD \u0BAA\u0BCB\u0BA4\u0BC1 \u0B89\u0BB2\u0BCB\u0B95\u0B95\u0BCD
      \u0B95\u0BC2\u0BA3\u0BCD\u0B9F\u0BBF\u0BB2\u0BCD \u0B8E\u0BA9\u0BCD\u0BA9 \u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95
      \u0BB5\u0BC7\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0928\u093F\u0930\u0940\u0915\u094D\u0937\u0923 \u0915\u0947 \u0926\u094C\u0930\u093E\u0928
      \u0927\u093E\u0924\u0941 \u0915\u0947 \u092A\u093F\u0902\u091C\u0930\u0947
      \u092A\u0930 \u0915\u094D\u092F\u093E \u091C\u093E\u0901\u091A \u0915\u0940
      \u091C\u093E\u0928\u0940 \u091A\u093E\u0939\u093F\u090F?"
    Object: {fileID: 0}
