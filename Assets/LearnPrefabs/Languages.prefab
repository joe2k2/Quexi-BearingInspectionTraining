  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Discoloration from overheating
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0BA4\u0BBF\u0B95 \u0BB5\u0BC6\u0BAA\u0BCD\u0BAA\u0BA4\u0BCD\u0BA4\u0BBE\u0BB2\u0BCD
      \u0BA8\u0BBF\u0BB1\u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BAE\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u091C\u093C\u094D\u092F\u093E\u0926\u093E \u0917\u0930\u092E \u0939\u094B\u0928\u0947
      \u0938\u0947 \u0930\u0902\u0917 \u092C\u0926\u0932\u0928\u093E"
