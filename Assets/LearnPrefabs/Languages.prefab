  data: 0
  entries:
  - Language: English
    Text: Uneven wear between ball rows
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BA8\u0BCD\u0BA4\u0BC1 \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1
      \u0B87\u0B9F\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD \u0B9A\u0BC0\u0BB0\u0BB1\u0BCD\u0BB1
      \u0B89\u0B9F\u0BC8\u0B95\u0BB3\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0917\u0947\u0902\u0926 \u0915\u0940 \u092A\u0902\u0915\u094D\u0924\u093F\u092F\u094B\u0902
      \u0915\u0947 \u092C\u0940\u091A \u0905\u0938\u092E\u093E\u0928 \u0918\u093F\u0938\u093E\u0935"
