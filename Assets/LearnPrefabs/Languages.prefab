--- !u!114 &2229289796916853031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 157231064650454167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Next, take the silver cage, fit the balls into it.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BA4\u0BBE\u0B95, \u0BB5\u0BC6\u0BB3\u0BCD\u0BB3\u0BBF
      \u0B95\u0BC7\u0B9C\u0BC8 (Silver Cage) \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1
      \u0B85\u0BA4\u0BBF\u0BB2\u0BCD \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BC8
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0907\u0938\u0915\u0947 \u092C\u093E\u0926, \u0938\u093F\u0932\u094D\u0935\u0930
      \u0915\u0947\u091C (Silver Cage) \u0932\u0947\u0902, \u0909\u0938\u092E\u0947\u0902
      \u092C\u0949\u0932\u094D\u0938 \u092B\u093F\u091F \u0915\u0930\u0947\u0902
      \u0914\u0930 \u0909\u0938 \u0938\u0947\u091F \u0915\u094B \u0938\u093E\u0935\u0927\u093E\u0928\u0940\u092A\u0942\u0930\u094D\u0935\u0915
      \u0907\u0928\u0930 \u0930\u093F\u0902\u0917 \u092A\u0930 \u0930\u0916\u0947\u0902."
    Object: {fileID: 0}
