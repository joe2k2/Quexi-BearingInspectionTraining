--- !u!114 &268969253161895678
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6338765624951905736}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Transfer load between hub and bearing
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BB9\u0BAA\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD
      \u0B87\u0B9F\u0BC8\u0BAF\u0BC7 \u0B9A\u0BC1\u0BAE\u0BC8\u0B95\u0BB3\u0BC8 \u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BB5\u0BC1\u0BAE\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0939\u092C \u0914\u0930 \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u0947
      \u092C\u0940\u091A \u092D\u093E\u0930 \u0938\u094D\u0925\u093E\u0928\u093E\u0902\u0924\u0930\u093F\u0924
      \u0915\u0930\u0947\u0902"
    Object: {fileID: 0}
