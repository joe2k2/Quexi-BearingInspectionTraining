--- !u!114 &502253495788793649
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7208246095007968964}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: A wheel hub bearing made of separate components such as inner ring, outer
      ring, balls, and seals. It supports wheel rotation while carrying both radial
      and axial vehicle loads. This design requires proper assembly and precise installation.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B89\u0BB3\u0BCD \u0BB5\u0BB3\u0BC8\u0BAF\u0BAE\u0BCD, \u0BB5\u0BC6\u0BB3\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1\u0BB1
      \u0BB5\u0BB3\u0BC8\u0BAF\u0BAE\u0BCD, \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BCD
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF\u0BB0\u0BC8\u0B95\u0BB3\u0BCD
      \u0BAA\u0BCB\u0BA9\u0BCD\u0BB1 \u0BA4\u0BA9\u0BBF\u0BA4\u0BCD\u0BA4\u0BA9\u0BBF
      \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BBE\u0BB2\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F
      \u0BB5\u0BC0\u0BB2\u0BCD \u0BB9\u0BAA\u0BCD \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF.
      \u0B87\u0BA4\u0BC1 \u0BB0\u0BC7\u0B9F\u0BBF\u0BAF\u0BB2\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0B85\u0B9A\u0BCD\u0B9A\u0BC1 \u0BB5\u0BBE\u0B95\u0BA9 \u0B9A\u0BC1\u0BAE\u0BC8\u0B95\u0BB3\u0BC8
      \u0B9A\u0BC1\u0BAE\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0BAA\u0BCB\u0BA4\u0BC1
      \u0B9A\u0B95\u0BCD\u0B95\u0BB0 \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0B9A\u0BBF\u0BAF\u0BC8
      \u0B86\u0BA4\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1. \u0B87\u0BA8\u0BCD\u0BA4
      \u0BB5\u0B9F\u0BBF\u0BB5\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BBF\u0BB1\u0BCD\u0B95\u0BC1
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA4\u0BC1\u0BB2\u0BCD\u0BB2\u0BBF\u0BAF\u0BAE\u0BBE\u0BA9
      \u0BA8\u0BBF\u0BB1\u0BC1\u0BB5\u0BB2\u0BCD \u0BA4\u0BC7\u0BB5\u0BC8\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0906\u0902\u0924\u0930\u093F\u0915 \u0930\u093F\u0902\u0917, \u092C\u093E\u0939\u0930\u0940
      \u0930\u093F\u0902\u0917, \u092C\u0949\u0932 \u0914\u0930 \u0938\u0940\u0932
      \u091C\u0948\u0938\u0947 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0918\u091F\u0915\u094B\u0902
      \u0938\u0947 \u092C\u0928\u093E \u090F\u0915 \u0935\u094D\u0939\u0940\u0932
      \u0939\u092C \u092C\u0947\u092F\u0930\u093F\u0902\u0917\u0964 \u092F\u0939
      \u0930\u0947\u0921\u093F\u092F\u0932 \u0914\u0930 \u0905\u0915\u094D\u0937\u0940\u092F
      \u0935\u093E\u0939\u0928 \u092D\u093E\u0930 \u0926\u094B\u0928\u094B\u0902
      \u0915\u094B \u0932\u0947 \u091C\u093E\u0928\u0947 \u0915\u0947 \u0926\u094C\u0930\u093E\u0928
      \u0935\u094D\u0939\u0940\u0932 \u0930\u094B\u091F\u0947\u0936\u0928 \u0915\u093E
      \u0938\u092E\u0930\u094D\u0925\u0928 \u0915\u0930\u0924\u093E \u0939\u0948\u0964
      \u0907\u0938 \u0921\u093F\u091C\u093C\u093E\u0907\u0928 \u0915\u0947 \u0932\u093F\u090F
      \u0909\u091A\u093F\u0924 \u0905\u0938\u0947\u0902\u092C\u0932\u0940 \u0914\u0930
      \u0938\u091F\u0940\u0915 \u0938\u094D\u0925\u093E\u092A\u0928\u093E \u0915\u0940
      \u0906\u0935\u0936\u094D\u092F\u0915\u0924\u093E \u0939\u094B\u0924\u0940 \u0939\u0948\u0964"
    Object: {fileID: 0}
