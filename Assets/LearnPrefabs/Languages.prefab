  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What is the function of the B1 ring?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "B1 \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BA9\u0BCD \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BC1
      \u0B8E\u0BA9\u0BCD\u0BA9?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "B1 \u0930\u093F\u0902\u0917 \u0915\u093E \u0915\u094D\u092F\u093E \u0915\u093E\u0930\u094D\u092F
      \u0939\u0948?"
    Object: {fileID: 0}
