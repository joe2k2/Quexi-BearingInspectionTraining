  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Looseness between bearing and hub
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BB9\u0BAA\u0BCD \u0B87\u0B9F\u0BC8\u0BAF\u0BC7 \u0BA4\u0BB3\u0BB0\u0BCD\u0BB5\u0BC1"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u093F\u092F\u0930\u093F\u0902\u0917 \u0914\u0930 \u0939\u092C \u0915\u0947
      \u092C\u0940\u091A \u0922\u0940\u0932\u093E\u092A\u0928"
    Object: {fileID: 0}
