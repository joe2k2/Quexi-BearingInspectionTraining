--- !u!114 &1462520108860341668
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4915803269927144204}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'The outer ring is the fixed part of the bearing that fits inside the housing.
      It provides a smooth raceway for the balls to roll and supports the load from
      the rotating shaft.


      Check for: cracks, dents, corrosion, correct outer
      diameter, and smooth raceway surface without scratches or waviness.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BB5\u0BC6\u0BB3\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1\u0BB1 \u0BB5\u0BB3\u0BC8\u0BAF\u0BAE\u0BCD
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC1 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD
      \u0BA8\u0BBF\u0BB2\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAA\u0B95\u0BC1\u0BA4\u0BBF\u0BAF\u0BBE\u0B95\u0BC1\u0BAE\u0BCD,
      \u0B87\u0BA4\u0BC1 \u0BB5\u0BC0\u0B9F\u0BCD\u0B9F\u0BC1\u0BB5\u0B9A\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BC1\u0BB3\u0BCD
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \u0B87\u0BA4\u0BC1 \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BCD \u0B89\u0BB0\u0BC1\u0BB3
      \u0B92\u0BB0\u0BC1 \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAA\u0BA8\u0BCD\u0BA4\u0BAF\u0BAA\u0BCD
      \u0BAA\u0BBE\u0BA4\u0BC8\u0BAF\u0BC8 \u0BB5\u0BB4\u0B99\u0BCD\u0B95\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0BC1\u0BB4\u0BB2\u0BC1\u0BAE\u0BCD
      \u0BA4\u0BA3\u0BCD\u0B9F\u0BBF\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1
      \u0B9A\u0BC1\u0BAE\u0BC8\u0BAF\u0BC8 \u0B86\u0BA4\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.\r\n\r\n\u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD:
      \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD\u0B95\u0BB3\u0BCD, \u0BAA\u0BB3\u0BCD\u0BB3\u0B99\u0BCD\u0B95\u0BB3\u0BCD,
      \u0B85\u0BB0\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1, \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0BB5\u0BC6\u0BB3\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1\u0BB1 \u0BB5\u0BBF\u0B9F\u0BCD\u0B9F\u0BAE\u0BCD
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B95\u0BC0\u0BB1\u0BB2\u0BCD\u0B95\u0BB3\u0BCD
      \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0B85\u0BB2\u0BC8\u0B95\u0BB3\u0BCD \u0B87\u0BB2\u0BCD\u0BB2\u0BBE\u0BAE\u0BB2\u0BCD
      \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAA\u0BA8\u0BCD\u0BA4\u0BAF\u0BAA\u0BCD
      \u0BAA\u0BBE\u0BA4\u0BC8 \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BC1."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u093E \u092C\u093E\u0939\u0930\u0940
      \u0935\u0932\u092F \u0935\u0939 \u0938\u094D\u0925\u093F\u0930 \u092D\u093E\u0917
      \u0939\u0948 \u091C\u094B \u0939\u093E\u0909\u0938\u093F\u0902\u0917 \u0915\u0947
      \u0905\u0902\u0926\u0930 \u092B\u093F\u091F \u0939\u094B\u0924\u093E \u0939\u0948\u0964
      \u092F\u0939 \u0917\u0947\u0902\u0926\u094B\u0902 \u0915\u094B \u0932\u0941\u0922\u093C\u0915\u0928\u0947
      \u0915\u0947 \u0932\u093F\u090F \u090F\u0915 \u0938\u0941\u0917\u092E \u092E\u093E\u0930\u094D\u0917
      \u092A\u094D\u0930\u0926\u093E\u0928 \u0915\u0930\u0924\u093E \u0939\u0948
      \u0914\u0930 \u0918\u0942\u0930\u094D\u0923\u0928\u0936\u0940\u0932 \u0936\u093E\u092B\u094D\u091F
      \u0938\u0947 \u0906\u0928\u0947 \u0935\u093E\u0932\u0947 \u092D\u093E\u0930
      \u0915\u094B \u0938\u0939\u093E\u0930\u093E \u0926\u0947\u0924\u093E \u0939\u0948\u0964\r\n\r\n\u0928\u093F\u092E\u094D\u0928\u0932\u093F\u0916\u093F\u0924
      \u0915\u0940 \u091C\u093E\u0901\u091A \u0915\u0930\u0947\u0902: \u0926\u0930\u093E\u0930\u0947\u0902,
      \u0927\u0915\u094D\u0915\u0947, \u091C\u0902\u0917, \u0938\u0939\u0940 \u092C\u093E\u0939\u0930\u0940
      \u0935\u094D\u092F\u093E\u0938 \u0914\u0930 \u0916\u0930\u094B\u0902\u091A
      \u092F\u093E \u0932\u0939\u0930\u0926\u093E\u0930\u092A\u0928 \u0915\u0947
      \u092C\u093F\u0928\u093E \u091A\u093F\u0915\u0928\u0940 \u092E\u093E\u0930\u094D\u0917
      \u0938\u0924\u0939\u0964"
    Object: {fileID: 0}
