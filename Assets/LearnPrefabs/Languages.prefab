  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Detect wheel speed for braking control
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BBF\u0BB0\u0BC7\u0B95\u0BCD\u0B95\u0BBF\u0B99\u0BCD \u0B95\u0B9F\u0BCD\u0B9F\u0BC1\u0BAA\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BBE\u0BA9
      \u0B9A\u0B95\u0BCD\u0B95\u0BB0 \u0BB5\u0BC7\u0B95\u0BA4\u0BCD\u0BA4\u0BC8\u0B95\u0BCD
      \u0B95\u0BA3\u0BCD\u0B9F\u0BB1\u0BBF\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u094D\u0930\u0947\u0915\u093F\u0902\u0917 \u0928\u093F\u092F\u0902\u0924\u094D\u0930\u0923
      \u0915\u0947 \u0932\u093F\u090F \u092A\u0939\u093F\u090F \u0915\u0940 \u0917\u0924\u093F
      \u0915\u093E \u092A\u0924\u093E \u0932\u0917\u093E\u090F\u0902"
    Object: {fileID: 0}
