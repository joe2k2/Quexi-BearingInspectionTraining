  entries:
  - Language: English
    Text: Heat discoloration or cracking
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BB5\u0BC6\u0BAA\u0BCD\u0BAA \u0BA8\u0BBF\u0BB1\u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BAE\u0BCD
      \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0917\u0930\u094D\u092E\u0940 \u0938\u0947 \u0930\u0902\u0917 \u092C\u0926\u0932\u0928\u093E
