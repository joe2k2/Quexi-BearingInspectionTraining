--- !u!114 &4153069572297229447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8593333902657206462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Balls reduce friction between the inner and outer rings and carry the
      load during rotation, enabling smooth and efficient motion.


      Check for:
      uniform size, smooth and polished surface, no pitting, no corrosion, and no
      contamination.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BCD \u0B89\u0BB3\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BB5\u0BC6\u0BB3\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1\u0BB1 \u0BB5\u0BB3\u0BC8\u0BAF\u0B99\u0BCD\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1
      \u0B87\u0B9F\u0BC8\u0BAF\u0BBF\u0BB2\u0BBE\u0BA9 \u0B89\u0BB0\u0BBE\u0BAF\u0BCD\u0BB5\u0BC8\u0B95\u0BCD
      \u0B95\u0BC1\u0BB1\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1, \u0B9A\u0BC1\u0BB4\u0BB1\u0BCD\u0B9A\u0BBF\u0BAF\u0BBF\u0BA9\u0BCD
      \u0BAA\u0BCB\u0BA4\u0BC1 \u0B9A\u0BC1\u0BAE\u0BC8\u0BAF\u0BC8\u0B9A\u0BCD \u0B9A\u0BC1\u0BAE\u0BA8\u0BCD\u0BA4\u0BC1,
      \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BA4\u0BBF\u0BB1\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0BA4\u0BCD\u0BA4\u0BC8
      \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BA9\u0BCD\u0BB1\u0BA9.\r\n\r\n\u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD:
      \u0B9A\u0BC0\u0BB0\u0BBE\u0BA9 \u0B85\u0BB3\u0BB5\u0BC1, \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAA\u0BB3\u0BAA\u0BB3\u0BAA\u0BCD\u0BAA\u0BBE\u0BA9
      \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BC1, \u0B95\u0BC1\u0BB4\u0BBF\u0B95\u0BB3\u0BCD
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0B85\u0BB0\u0BBF\u0BAA\u0BCD\u0BAA\u0BC1
      \u0B87\u0BB2\u0BCD\u0BB2\u0BC8, \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BAE\u0BBE\u0B9A\u0BC1\u0BAA\u0BBE\u0B9F\u0BC1 \u0B87\u0BB2\u0BCD\u0BB2\u0BC8."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0917\u0947\u0902\u0926\u0947\u0902 \u0906\u0902\u0924\u0930\u093F\u0915
      \u0914\u0930 \u092C\u093E\u0939\u0930\u0940 \u091B\u0932\u094D\u0932\u094B\u0902
      \u0915\u0947 \u092C\u0940\u091A \u0918\u0930\u094D\u0937\u0923 \u0915\u094B
      \u0915\u092E \u0915\u0930\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0918\u0942\u0930\u094D\u0923\u0928
      \u0915\u0947 \u0926\u094C\u0930\u093E\u0928 \u092D\u093E\u0930 \u0935\u0939\u0928
      \u0915\u0930\u0924\u0940 \u0939\u0948\u0902, \u091C\u093F\u0938\u0938\u0947
      \u0938\u0941\u091A\u093E\u0930\u0942 \u0914\u0930 \u0915\u0941\u0936\u0932
      \u0917\u0924\u093F \u0938\u0902\u092D\u0935 \u0939\u094B\u0924\u0940 \u0939\u0948\u0964\r\n\r\n\u0928\u093F\u092E\u094D\u0928\u0932\u093F\u0916\u093F\u0924
      \u092C\u093E\u0924\u094B\u0902 \u0915\u0940 \u091C\u093E\u0901\u091A \u0915\u0930\u0947\u0902:
      \u090F\u0915\u0938\u092E\u093E\u0928 \u0906\u0915\u093E\u0930, \u091A\u093F\u0915\u0928\u0940
      \u0914\u0930 \u092A\u0949\u0932\u093F\u0936 \u0915\u0940 \u0939\u0941\u0908
      \u0938\u0924\u0939, \u0915\u094B\u0908 \u0917\u0921\u094D\u0922\u0947 \u0928\u0939\u0940\u0902,
      \u0915\u094B\u0908 \u091C\u0902\u0917 \u0928\u0939\u0940\u0902 \u0914\u0930
      \u0915\u094B\u0908 \u0938\u0902\u0926\u0942\u0937\u0923 \u0928\u0939\u0940\u0902\u0964"
    Object: {fileID: 0}
