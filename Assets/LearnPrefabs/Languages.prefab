--- !u!114 &9156461148823096598
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6330167092655414334}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: First, take the inner ring and place it properly on the surface.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAE\u0BC1\u0BA4\u0BB2\u0BBF\u0BB2\u0BCD, \u0B89\u0BB3\u0BCD \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BC8
      (Inner Ring) \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1 \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9
      \u0BAE\u0BC1\u0BB1\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BBF\u0BB2\u0BCD
      \u0BB5\u0BC8\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\n\u0938\u092C\u0938\u0947 \u092A\u0939\u0932\u0947, \u0907\u0928\u0930
      \u0930\u093F\u0902\u0917 (Inner Ring) \u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947
      \u0938\u0924\u0939 \u092A\u0930 \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947
      \u0938\u0947 \u0930\u0916\u0947\u0902\u0964"
    Object: {fileID: 0}
