--- !u!114 &4625600073170421487
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 99714424556129184}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What makes a Hub3 bearing different from Hub1?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "Hub3 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BC8 Hub1 \u0B87\u0BB2\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BC1
      \u0BB5\u0BC7\u0BB1\u0BC1\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0BB5\u0BA4\u0BC1
      \u0B8E\u0BA4\u0BC1?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0939\u092C3 \u092C\u093F\u092F\u0930\u093F\u0902\u0917 \u0915\u094B
