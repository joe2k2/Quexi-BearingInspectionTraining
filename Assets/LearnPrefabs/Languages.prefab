--- !u!114 &5947986204442288698
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7875469128191044623}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Now, take the B1 ring set and gently align it inner Ring, ensuring proper
      positioning without disturbing the ball arrangement. Make sure the raceways
      match correctly before applying pressure.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B87\u0BAA\u0BCD\u0BAA\u0BCB\u0BA4\u0BC1, B1 \u0BB0\u0BBF\u0B99\u0BCD
      \u0B9A\u0BC6\u0B9F\u0BCD\u0B9F\u0BC8 \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1
      \u0B85\u0BA4\u0BC8 \u0B87\u0BA9\u0BCD\u0B9F\u0BB0\u0BCD \u0BB0\u0BBF\u0B99\u0BCD\u0B95\u0BC1\u0B9F\u0BA9\u0BCD
      \u0BAE\u0BC6\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BC1\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD, \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1
      \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1 \u0B9A\u0BBF\u0BA4\u0BC8\u0BAF\u0BBE\u0BAE\u0BB2\u0BCD
      \u0B87\u0BB0\u0BC1\u0BAA\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF
      \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD. \u0B85\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BAE\u0BCD
      \u0B95\u0BCA\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BA9\u0BCD
      \u0BB0\u0BC7\u0BB8\u0BCD\u0BB5\u0BC7\u0B95\u0BB3\u0BCD \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BBF\u0BAF\u0BC1\u0BB3\u0BCD\u0BB3\u0BA9\u0BB5\u0BBE
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0905\u092C, B1 \u0930\u093F\u0902\u0917 \u0938\u0947\u091F \u0915\u094B
      \u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947 \u0907\u0928\u0930 \u0930\u093F\u0902\u0917
      \u0915\u0947 \u0938\u093E\u0925 \u0938\u093E\u0935\u0927\u093E\u0928\u0940\u092A\u0942\u0930\u094D\u0935\u0915
      \u0938\u0902\u0930\u0947\u0916\u093F\u0924 \u0915\u0930\u0947\u0902, \u092F\u0939
      \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924 \u0915\u0930\u0924\u0947
      \u0939\u0941\u090F \u0915\u093F \u092C\u0949\u0932 \u0915\u0940 \u0935\u094D\u092F\u0935\u0938\u094D\u0925\u093E
      \u092E\u0947\u0902 \u0915\u094B\u0908 \u092C\u0926\u0932\u093E\u0935 \u0928
      \u0939\u094B\u0964 \u0926\u092C\u093E\u0935 \u0932\u0917\u093E\u0928\u0947
      \u0938\u0947 \u092A\u0939\u0932\u0947 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0915\u0930\u0947\u0902 \u0915\u093F \u0930\u0947\u0938\u0935\u0947 \u0938\u0939\u0940
      \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u092E\u0947\u0932 \u0916\u093E
      \u0930\u0939\u0947 \u0939\u0948\u0902\u0964"
    Object: {fileID: 0}
