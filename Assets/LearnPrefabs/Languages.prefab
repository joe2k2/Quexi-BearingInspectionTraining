  - Language: English
    Text: Retain grease
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B95\u0BBF\u0BB0\u0BC0\u0BB8\u0BCD \u0BB5\u0BC8\u0BA4\u0BCD\u0BA4\u0BBF\u0BB0\u0BC1\u0B99\u0BCD\u0B95\u0BB3\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
