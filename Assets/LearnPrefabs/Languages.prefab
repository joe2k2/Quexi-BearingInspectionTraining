--- !u!114 &390479140610393455
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6808642307163493874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Welcome to the Bearing Assembly and Inspection Training.


      In this
      mixed reality experience, you will explore each bearing component, understand
      its function, and learn the key inspection checks required for safe and reliable
      operation.'
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B87\u0BA9\u0BCD\u0BB8\u0BCD\u0BAA\u0BC6\u0B95\u0BCD\u0BB7\u0BA9\u0BCD
      \u0BAA\u0BAF\u0BBF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BC1 \u0BB5\u0BB0\u0BB5\u0BC7\u0BB1\u0BCD\u0B95\u0BBF\u0BB1\u0BCB\u0BAE\u0BCD.
      \n\n\u0B87\u0BA8\u0BCD\u0BA4 \u0B95\u0BB2\u0BAA\u0BCD\u0BAA\u0BC1 \u0BB0\u0BBF\u0BAF\u0BBE\u0BB2\u0BBF\u0B9F\u0BCD\u0B9F\u0BBF
      \u0B85\u0BA9\u0BC1\u0BAA\u0BB5\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD, \u0BA8\u0BC0\u0B99\u0BCD\u0B95\u0BB3\u0BCD
      \u0B92\u0BB5\u0BCD\u0BB5\u0BCA\u0BB0\u0BC1 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF
      \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BC8\u0BAF\u0BC1\u0BAE\u0BCD \u0B86\u0BB0\u0BBE\u0BAF\u0BCD\u0BB5\u0BC0\u0BB0\u0BCD\u0B95\u0BB3\u0BCD,
      \u0B85\u0BA4\u0BA9\u0BCD \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BC8\u0BAA\u0BCD
      \u0BAA\u0BC1\u0BB0\u0BBF\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BCA\u0BB3\u0BCD\u0BB5\u0BC0\u0BB0\u0BCD\u0B95\u0BB3\u0BCD
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0BAA\u0BCD\u0BAA\u0BBE\u0BA9
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA8\u0BAE\u0BCD\u0BAA\u0B95\u0BAE\u0BBE\u0BA9
      \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BBF\u0BB1\u0BCD\u0B95\u0BC1\u0BA4\u0BCD
      \u0BA4\u0BC7\u0BB5\u0BC8\u0BAF\u0BBE\u0BA9 \u0BAE\u0BC1\u0B95\u0BCD\u0B95\u0BBF\u0BAF
      \u0B86\u0BAF\u0BCD\u0BB5\u0BC1\u0B9A\u0BCD \u0B9A\u0BCB\u0BA4\u0BA9\u0BC8\u0B95\u0BB3\u0BC8\u0B95\u0BCD
      \u0B95\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BCA\u0BB3\u0BCD\u0BB5\u0BC0\u0BB0\u0BCD\u0B95\u0BB3\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u093F\u092F\u0930\u093F\u0902\u0917 \u0905\u0938\u0947\u0902\u092C\u0932\u0940
      \u0914\u0930 \u0928\u093F\u0930\u0940\u0915\u094D\u0937\u0923 \u092A\u094D\u0930\u0936\u093F\u0915\u094D\u0937\u0923
      \u092E\u0947\u0902 \u0906\u092A\u0915\u093E \u0938\u094D\u0935\u093E\u0917\u0924
      \u0939\u0948\u0964 \n\n\u0907\u0938 \u092E\u093F\u0936\u094D\u0930\u093F\u0924
      \u0935\u093E\u0938\u094D\u0924\u0935\u093F\u0915\u0924\u093E \u0905\u0928\u0941\u092D\u0935
      \u092E\u0947\u0902, \u0906\u092A \u092A\u094D\u0930\u0924\u094D\u092F\u0947\u0915
      \u092C\u093F\u092F\u0930\u093F\u0902\u0917 \u0918\u091F\u0915 \u0915\u093E
      \u092A\u0924\u093E \u0932\u0917\u093E\u090F\u0902\u0917\u0947, \u0909\u0938\u0915\u0947
      \u0915\u093E\u0930\u094D\u092F \u0915\u094B \u0938\u092E\u091D\u0947\u0902\u0917\u0947,
      \u0914\u0930 \u0938\u0941\u0930\u0915\u094D\u0937\u093F\u0924 \u0914\u0930
      \u0935\u093F\u0936\u094D\u0935\u0938\u0928\u0940\u092F \u0938\u0902\u091A\u093E\u0932\u0928
      \u0915\u0947 \u0932\u093F\u090F \u0906\u0935\u0936\u094D\u092F\u0915 \u092A\u094D\u0930\u092E\u0941\u0916
      \u0928\u093F\u0930\u0940\u0915\u094D\u0937\u0923 \u091C\u093E\u0902\u091A \u0938\u0940\u0916\u0947\u0902\u0917\u0947\u0964"
    Object: {fileID: 0}
