--- !u!114 &5094680560310545765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3406968182322457677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Start to learn how to align and assemble the Hub3 bearing step by step.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "Hub3 \u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD\u0B95\u0BC8 \u0BAA\u0B9F\u0BBF\u0BAA\u0BCD\u0BAA\u0B9F\u0BBF\u0BAF\u0BBE\u0B95
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95 \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BC1\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BCD
      \u0B9A\u0BC6\u0BAF\u0BCD\u0BB5\u0BA4\u0BC1 \u0B8E\u0BAA\u0BCD\u0BAA\u0B9F\u0BBF
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8 \u0B95\u0BB1\u0BCD\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BCA\u0BB3\u0BCD\u0BB3
      \u0BA4\u0BCA\u0B9F\u0B99\u0BCD\u0B95\u0BC1\u0B99\u0BCD\u0B95\u0BB3\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "Hub3 \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u094B \u091A\u0930\u0923\u092C\u0926\u094D\u0927
      \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0938\u0939\u0940 \u0922\u0902\u0917
      \u0938\u0947 \u0938\u0902\u0930\u0947\u0916\u093F\u0924 \u0914\u0930 \u0905\u0938\u0947\u0902\u092C\u0932
      \u0915\u0930\u0928\u093E \u0938\u0940\u0916\u0928\u093E \u0936\u0941\u0930\u0942
      \u0915\u0930\u0947\u0902\u0964"
    Object: {fileID: 0}
