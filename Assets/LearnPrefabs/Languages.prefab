  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What should be checked on Seal S1?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B9A\u0BC0\u0BB2\u0BCD S1 \u0B87\u0BB2\u0BCD \u0B8E\u0BA9\u0BCD\u0BA9
      \u0B9A\u0BB0\u0BBF\u0BAA\u0BBE\u0BB0\u0BCD\u0B95\u0BCD\u0B95 \u0BB5\u0BC7\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0938\u0940\u0932 S1 \u092A\u0930 \u0915\u094D\u092F\u093E \u091C\u093E\u0901\u091A
      \u0915\u0940 \u091C\u093E\u0928\u0940 \u091A\u093E\u0939\u093F\u090F?"
    Object: {fileID: 0}
