  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Which cage type is commonly used in MCB bearings?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "MCB \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BC1 \u0B89\u0BB0\u0BC1\u0BB3\u0BC8\u0B95\u0BB3\u0BBF\u0BB2\u0BCD
      \u0BAA\u0BCA\u0BA4\u0BC1\u0BB5\u0BBE\u0B95\u0BAA\u0BCD \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BAE\u0BCD
      \u0B95\u0BC2\u0BA3\u0BCD\u0B9F\u0BC1 \u0BB5\u0B95\u0BC8 \u0B8E\u0BA4\u0BC1?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u090F\u092E\u0938\u0940\u092C\u0940 \u092C\u093F\u092F\u0930\u093F\u0902\u0917\u094D\u0938
      \u092E\u0947\u0902 \u0906\u092E\u0924\u094C\u0930 \u092A\u0930 \u0915\u093F\u0938
      \u0915\u0947\u091C \u092A\u094D\u0930\u0915\u093E\u0930 \u0915\u093E \u0909\u092A\u092F\u094B\u0917
      \u0915\u093F\u092F\u093E \u091C\u093E\u0924\u093E \u0939\u0948?"
    Object: {fileID: 0}
