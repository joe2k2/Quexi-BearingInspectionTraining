  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Which component connects the wheel to the bearing assembly?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B9A\u0B95\u0BCD\u0B95\u0BB0\u0BA4\u0BCD\u0BA4\u0BC8 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF
      \u0B9A\u0B9F\u0BCD\u0B9F\u0B9A\u0BAA\u0BC8\u0BAF\u0BC1\u0B9F\u0BA9\u0BCD \u0B87\u0BA3\u0BC8\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD
      \u0B95\u0BC2\u0BB1\u0BC1 \u0B8E\u0BA4\u0BC1?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0915\u094C\u0928 \u0938\u093E \u0918\u091F\u0915 \u092A\u0939\u093F\u092F\u093E
      \u0915\u094B \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0905\u0938\u0947\u0902\u092C\u0932\u0940
      \u0938\u0947 \u091C\u094B\u0921\u093C\u0924\u093E \u0939\u0948?"
    Object: {fileID: 0}
