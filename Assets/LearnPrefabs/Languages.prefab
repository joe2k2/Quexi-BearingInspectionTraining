--- !u!114 &999590906329343353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4453804840337264688}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: First, take the inner ring and place it properly on the assembly surface.
      Insert and tighten the bolt into the inner ring at this stage to provide proper
      support and prevent movement during assembly. Confirm that the inner ring is
      stable and correctly aligned.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAE\u0BC1\u0BA4\u0BB2\u0BBF\u0BB2\u0BCD, \u0B87\u0BA9\u0BCD\u0B9F\u0BB0\u0BCD
      \u0BB0\u0BBF\u0B99\u0BCD\u0B95\u0BC8 \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1
      \u0B85\u0BA4\u0BC8 \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BBF\u0BB2\u0BCD
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95 \u0BB5\u0BC8\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD.
      \u0B87\u0BA8\u0BCD\u0BA4 \u0BA8\u0BBF\u0BB2\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD \u0B87\u0BA9\u0BCD\u0B9F\u0BB0\u0BCD
      \u0BB0\u0BBF\u0B99\u0BCD\u0B95\u0BBF\u0BB2\u0BCD \u0BAA\u0BCB\u0BB2\u0BCD\u0B9F\u0BCD\u0B9F\u0BC8
      \u0B9A\u0BC6\u0BB0\u0BC1\u0B95\u0BBF \u0BA8\u0BA9\u0BCD\u0BB1\u0BBE\u0B95 \u0B87\u0BB1\u0BC1\u0B95\u0BCD\u0B95\u0BBF
      \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD, \u0B87\u0BA4\u0BC1
      \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BC1\u0BAE\u0BCD
      \u0BAA\u0BCB\u0BA4\u0BC1 \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BC8
      \u0BB5\u0BB4\u0B99\u0BCD\u0B95\u0BBF \u0B85\u0B9A\u0BC8\u0BB5\u0BA4\u0BC8\u0BA4\u0BCD
      \u0BA4\u0B9F\u0BC1\u0B95\u0BCD\u0B95 \u0B89\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD.
      \u0B87\u0BA9\u0BCD\u0B9F\u0BB0\u0BCD \u0BB0\u0BBF\u0B99\u0BCD \u0BA8\u0BBF\u0BB2\u0BC8\u0BAF\u0BBE\u0B95\u0BB5\u0BC1\u0BAE\u0BCD
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BBF\u0BB2\u0BC1\u0BAE\u0BCD
      \u0B87\u0BB0\u0BC1\u0BAA\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF
      \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0938\u092C\u0938\u0947 \u092A\u0939\u0932\u0947, \u0907\u0928\u0930
      \u0930\u093F\u0902\u0917 \u0915\u094B \u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947
      \u0905\u0938\u0947\u0902\u092C\u0932\u0940 \u0938\u0924\u0939 \u092A\u0930
      \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0930\u0916\u0947\u0902\u0964
      \u0907\u0938 \u091A\u0930\u0923 \u092E\u0947\u0902 \u0907\u0928\u0930 \u0930\u093F\u0902\u0917
      \u092E\u0947\u0902 \u092C\u094B\u0932\u094D\u091F \u0921\u093E\u0932\u0915\u0930
      \u0905\u091A\u094D\u091B\u0940 \u0924\u0930\u0939 \u0915\u0938 \u0926\u0947\u0902
      \u0924\u093E\u0915\u093F \u0905\u0938\u0947\u0902\u092C\u0932\u0940 \u0915\u0947
      \u0926\u094C\u0930\u093E\u0928 \u0935\u0939 \u0938\u094D\u0925\u093F\u0930
      \u0930\u0939\u0947 \u0914\u0930 \u0939\u093F\u0932\u0947 \u0928\u0939\u0940\u0902\u0964
      \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924 \u0915\u0930\u0947\u0902
      \u0915\u093F \u0907\u0928\u0930 \u0930\u093F\u0902\u0917 \u0938\u094D\u0925\u093F\u0930
      \u0914\u0930 \u0938\u0939\u0940 \u0938\u0902\u0930\u0947\u0916\u0923 \u092E\u0947\u0902
      \u0939\u0948\u0964"
    Object: {fileID: 0}
