  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Bolt hole wear or misalignment
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BAA\u0BCB\u0BB2\u0BCD\u0B9F\u0BCD \u0BA4\u0BC1\u0BB3\u0BC8 \u0BA4\u0BC7\u0BAF\u0BCD\u0BAE\u0BBE\u0BA9\u0BAE\u0BCD
      \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0BA4\u0BB5\u0BB1\u0BBE\u0BA9 \u0B9A\u0BC0\u0BB0\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u094B\u0932\u094D\u091F \u0915\u093E \u091B\u0947\u0926 \u0918\u093F\u0938\u0928\u093E
      \u092F\u093E \u0917\u0932\u0924 \u0938\u0902\u0930\u0947\u0916\u0923"
    Object: {fileID: 0}
