--- !u!114 &2622115384504515426
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5592866236090412837}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: A fully integrated wheel hub unit combining the bearing, hub flange, and
      mounting components. It is commonly used in modern vehicles and often includes
      ABS sensor integration. The integrated design reduces installation time and
      improves wheel alignment accuracy.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF, \u0BB9\u0BAA\u0BCD \u0B83\u0BAA\u0BBF\u0BB3\u0BC7\u0BA9\u0BCD\u0B9C\u0BCD
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAE\u0BB5\u0BC1\u0BA3\u0BCD\u0B9F\u0BBF\u0B99\u0BCD
      \u0B95\u0BC2\u0BB1\u0BC1\u0B95\u0BB3\u0BC8 \u0B87\u0BA3\u0BC8\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD
      \u0B92\u0BB0\u0BC1 \u0BAE\u0BC1\u0BB4\u0BC1 \u0B92\u0BB0\u0BC1\u0B99\u0BCD\u0B95\u0BBF\u0BA3\u0BC8\u0BA8\u0BCD\u0BA4
      \u0BB5\u0BC0\u0BB2\u0BCD \u0BB9\u0BAA\u0BCD \u0BAF\u0BC2\u0BA9\u0BBF\u0B9F\u0BCD.
      \u0B87\u0BA4\u0BC1 \u0BAA\u0BCA\u0BA4\u0BC1\u0BB5\u0BBE\u0B95 \u0BA8\u0BB5\u0BC0\u0BA9
      \u0BB5\u0BBE\u0B95\u0BA9\u0B99\u0BCD\u0B95\u0BB3\u0BBF\u0BB2\u0BCD \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BAA\u0BC6\u0BB0\u0BC1\u0BAE\u0BCD\u0BAA\u0BBE\u0BB2\u0BC1\u0BAE\u0BCD
      \u0B8F\u0BAA\u0BBF\u0B8E\u0BB8\u0BCD \u0B9A\u0BC6\u0BA9\u0BCD\u0B9A\u0BBE\u0BB0\u0BCD
      \u0B92\u0BB0\u0BC1\u0B99\u0BCD\u0B95\u0BBF\u0BA3\u0BC8\u0BAA\u0BCD\u0BAA\u0BC8
      \u0B89\u0BB3\u0BCD\u0BB3\u0B9F\u0B95\u0BCD\u0B95\u0BBF\u0BAF\u0BA4\u0BC1. \u0B92\u0BB0\u0BC1\u0B99\u0BCD\u0B95\u0BBF\u0BA3\u0BC8\u0BA8\u0BCD\u0BA4
      \u0BB5\u0B9F\u0BBF\u0BB5\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1 \u0BA8\u0BBF\u0BB1\u0BC1\u0BB5\u0BB2\u0BCD
      \u0BA8\u0BC7\u0BB0\u0BA4\u0BCD\u0BA4\u0BC8 \u0B95\u0BC1\u0BB1\u0BC8\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B9A\u0B95\u0BCD\u0B95\u0BB0 \u0B9A\u0BC0\u0BB0\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1
      \u0BA4\u0BC1\u0BB2\u0BCD\u0BB2\u0BBF\u0BAF\u0BA4\u0BCD\u0BA4\u0BC8 \u0BAE\u0BC7\u0BAE\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u093F\u092F\u0930\u093F\u0902\u0917, \u0939\u092C \u092B\u094D\u0932\u0948\u0902\u091C
      \u0914\u0930 \u092E\u093E\u0909\u0902\u091F\u093F\u0902\u0917 \u0918\u091F\u0915\u094B\u0902
      \u0915\u094B \u0938\u0902\u092F\u094B\u091C\u093F\u0924 \u0915\u0930\u0928\u0947
      \u0935\u093E\u0932\u0940 \u090F\u0915 \u092A\u0942\u0930\u0940 \u0924\u0930\u0939
      \u0938\u0947 \u090F\u0915\u0940\u0915\u0943\u0924 \u0935\u094D\u0939\u0940\u0932
      \u0939\u092C \u0907\u0915\u093E\u0908\u0964 \u0907\u0938\u0915\u093E \u0909\u092A\u092F\u094B\u0917
      \u0906\u092E\u0924\u094C\u0930 \u092A\u0930 \u0906\u0927\u0941\u0928\u093F\u0915
      \u0935\u093E\u0939\u0928\u094B\u0902 \u092E\u0947\u0902 \u0915\u093F\u092F\u093E
      \u091C\u093E\u0924\u093E \u0939\u0948 \u0914\u0930 \u0907\u0938\u092E\u0947\u0902
      \u0905\u0915\u094D\u0938\u0930 \u090F\u092C\u0940\u090F\u0938 \u0938\u0947\u0902\u0938\u0930
      \u090F\u0915\u0940\u0915\u0930\u0923 \u0936\u093E\u092E\u093F\u0932 \u0939\u094B\u0924\u093E
      \u0939\u0948\u0964 \u090F\u0915\u0940\u0915\u0943\u0924 \u0921\u093F\u091C\u093E\u0907\u0928
      \u0938\u094D\u0925\u093E\u092A\u0928\u093E \u0915\u0947 \u0938\u092E\u092F
      \u0915\u094B \u0915\u092E \u0915\u0930\u0924\u093E \u0939\u0948 \u0914\u0930
      \u092A\u0939\u093F\u092F\u093E \u0938\u0902\u0930\u0947\u0916\u0923 \u0938\u091F\u0940\u0915\u0924\u093E
      \u092E\u0947\u0902 \u0938\u0941\u0927\u093E\u0930 \u0915\u0930\u0924\u093E
      \u0939\u0948\u0964"
    Object: {fileID: 0}
