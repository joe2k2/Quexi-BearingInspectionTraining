--- !u!114 &509759473679200373
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3737119405398124330}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: A bearing is a mechanical component used to support rotating parts and
      reduce friction between moving surfaces. It helps ensure smooth, stable, and
      efficient motion while carrying loads, improving performance, reliability,
      and the overall life of machines.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B92\u0BB0\u0BC1 \u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC1
      \u0B9A\u0BC1\u0BB4\u0BB2\u0BC1\u0BAE\u0BCD \u0BAA\u0BBE\u0B95\u0B99\u0BCD\u0B95\u0BB3\u0BC8
      \u0B86\u0BA4\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD \u0BA8\u0B95\u0BB0\u0BC1\u0BAE\u0BCD
      \u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0BB0\u0BAA\u0BCD\u0BAA\u0BC1\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BC1
      \u0B87\u0B9F\u0BC8\u0BAF\u0BBF\u0BB2\u0BBE\u0BA9 \u0B89\u0BB0\u0BBE\u0BAF\u0BCD\u0BB5\u0BC8\u0B95\u0BCD
      \u0B95\u0BC1\u0BB1\u0BC8\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BAE\u0BCD
      \u0B92\u0BB0\u0BC1 \u0B87\u0BAF\u0BA8\u0BCD\u0BA4\u0BBF\u0BB0 \u0B95\u0BC2\u0BB1\u0BC1
      \u0B86\u0B95\u0BC1\u0BAE\u0BCD. \u0B87\u0BA4\u0BC1 \u0B9A\u0BC1\u0BAE\u0BC8\u0B95\u0BB3\u0BC8\u0B9A\u0BCD
      \u0B9A\u0BC1\u0BAE\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD \u0BAA\u0BCB\u0BA4\u0BC1
      \u0BAE\u0BC6\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9, \u0BA8\u0BBF\u0BB2\u0BC8\u0BAF\u0BBE\u0BA9
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA4\u0BBF\u0BB1\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9
      \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0BA4\u0BCD\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF
      \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF \u0B89\u0BA4\u0BB5\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1,
      \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BA4\u0BBF\u0BB1\u0BA9\u0BCD, \u0BA8\u0BAE\u0BCD\u0BAA\u0B95\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8
      \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0B87\u0BAF\u0BA8\u0BCD\u0BA4\u0BBF\u0BB0\u0B99\u0BCD\u0B95\u0BB3\u0BBF\u0BA9\u0BCD
      \u0B92\u0B9F\u0BCD\u0B9F\u0BC1\u0BAE\u0BCA\u0BA4\u0BCD\u0BA4 \u0B86\u0BAF\u0BC1\u0BB3\u0BC8
      \u0BAE\u0BC7\u0BAE\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u090F\u0915 \u092F\u093E\u0902\u0924\u094D\u0930\u093F\u0915
      \u0918\u091F\u0915 \u0939\u0948 \u091C\u093F\u0938\u0915\u093E \u0909\u092A\u092F\u094B\u0917
      \u0918\u0942\u0930\u094D\u0923\u0928\u0936\u0940\u0932 \u092D\u093E\u0917\u094B\u0902
      \u0915\u094B \u0938\u0939\u093E\u0930\u093E \u0926\u0947\u0928\u0947 \u0914\u0930
      \u0917\u0924\u093F\u0936\u0940\u0932 \u0938\u0924\u0939\u094B\u0902 \u0915\u0947
      \u092C\u0940\u091A \u0918\u0930\u094D\u0937\u0923 \u0915\u094B \u0915\u092E
      \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0915\u093F\u092F\u093E
      \u091C\u093E\u0924\u093E \u0939\u0948\u0964 \u092F\u0939 \u092D\u093E\u0930
      \u0935\u0939\u0928 \u0915\u0930\u0924\u0947 \u0938\u092E\u092F \u0938\u0941\u091A\u093E\u0930\u0942,
      \u0938\u094D\u0925\u093F\u0930 \u0914\u0930 \u0915\u0941\u0936\u0932 \u0917\u0924\u093F
      \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924 \u0915\u0930\u0928\u0947
      \u092E\u0947\u0902 \u092E\u0926\u0926 \u0915\u0930\u0924\u093E \u0939\u0948,
      \u091C\u093F\u0938\u0938\u0947 \u092E\u0936\u0940\u0928\u094B\u0902 \u0915\u093E
      \u092A\u094D\u0930\u0926\u0930\u094D\u0936\u0928, \u0935\u093F\u0936\u094D\u0935\u0938\u0928\u0940\u092F\u0924\u093E
      \u0914\u0930 \u0938\u092E\u0917\u094D\u0930 \u091C\u0940\u0935\u0928\u0915\u093E\u0932
      \u092C\u0947\u0939\u0924\u0930 \u0939\u094B\u0924\u093E \u0939\u0948\u0964"
    Object: {fileID: 0}
