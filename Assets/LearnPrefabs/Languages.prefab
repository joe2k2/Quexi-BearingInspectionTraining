  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Uses fewer balls
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B95\u0BC1\u0BB1\u0BC8\u0BB5\u0BBE\u0BA9 \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BC8\u0BAA\u0BCD
      \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0915\u092E \u0917\u0947\u0902\u0926\u094B\u0902 \u0915\u093E \u0909\u092A\u092F\u094B\u0917
      \u0915\u0930\u0924\u093E \u0939\u0948"
    Object: {fileID: 0}
