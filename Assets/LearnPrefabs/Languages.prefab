  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: carefully place the set onto the inner ring, aligning it correctly.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0BA8\u0BCD\u0BA4 \u0BA4\u0BCA\u0B95\u0BC1\u0BA4\u0BBF\u0BAF\u0BC8
      \u0B89\u0BB3\u0BCD \u0BB5\u0BB3\u0BC8\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BA9\u0BCD
      \u0BAE\u0BC0\u0BA4\u0BC1 \u0B95\u0BB5\u0BA9\u0BAE\u0BBE\u0B95 \u0BB5\u0BC8\u0BA4\u0BCD\u0BA4\u0BC1
      \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95 \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BC1\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0938\u0902\u0930\u0947\u0916\u093F\u0924
      \u0915\u0930\u0947\u0902\u0964"
    Object: {fileID: 0}
