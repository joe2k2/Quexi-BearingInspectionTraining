  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "MCB Bearing \n(Double Row)"
    Object: {fileID: 0}
  - Language: Tamil
    Text: "MCB \u0BAA\u0BC7\u0BB0\u0BBF\u0B99\u0BCD \n(\u0B87\u0BB0\u0B9F\u0BCD\u0B9F\u0BC8
