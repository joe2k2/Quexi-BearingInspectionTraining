  m_GameObject: {fileID: 1854653960264807544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: What best describes a Hub1 bearing?
    Object: {fileID: 0}
  - Language: Tamil
    Text: "Hub1 \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF\u0BAF\u0BC8 \u0B8E\u0BA4\u0BC1
      \u0B9A\u0BBF\u0BB1\u0BAA\u0BCD\u0BAA\u0BBE\u0B95 \u0BB5\u0BBF\u0BB5\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1?"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0939\u092C1 \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u0915\u093E
      \u0938\u092C\u0938\u0947 \u0905\u091A\u094D\u091B\u093E \u0935\u0930\u094D\u0923\u0928
      \u0915\u094D\u092F\u093E \u0939\u0948?"
    Object: {fileID: 0}
