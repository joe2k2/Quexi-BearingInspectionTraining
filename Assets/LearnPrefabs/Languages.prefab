--- !u!114 &4349831300941565334
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 124442606466764157}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: A bearing that uses two rows of balls to support higher radial and axial
      loads. The double-row design improves load distribution, stability, and durability.
      It is often used in motorcycle wheels and compact automotive applications.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0BA4\u0BBF\u0B95 \u0BB0\u0BC7\u0B9F\u0BBF\u0BAF\u0BB2\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0B85\u0B9A\u0BCD\u0B9A\u0BC1 \u0B9A\u0BC1\u0BAE\u0BC8\u0B95\u0BB3\u0BC8 \u0B86\u0BA4\u0BB0\u0BBF\u0B95\u0BCD\u0B95
      \u0B87\u0BB0\u0BA3\u0BCD\u0B9F\u0BC1 \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8 \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BC8\u0BAA\u0BCD
      \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0BAE\u0BCD
      \u0BA4\u0BBE\u0B99\u0BCD\u0B95\u0BBF. \u0B87\u0BB0\u0B9F\u0BCD\u0B9F\u0BC8
      \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8 \u0BB5\u0B9F\u0BBF\u0BB5\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1
      \u0B9A\u0BC1\u0BAE\u0BC8 \u0BB5\u0BBF\u0BA8\u0BBF\u0BAF\u0BCB\u0B95\u0BAE\u0BCD,
      \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8 \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0BA8\u0BC0\u0B9F\u0BBF\u0BA4\u0BCD\u0BA4\u0BC1 \u0BA8\u0BBF\u0BB2\u0BC8\u0BA4\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8\u0BAF\u0BC8
      \u0BAE\u0BC7\u0BAE\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1.
      \u0B87\u0BA4\u0BC1 \u0BAA\u0BC6\u0BB0\u0BC1\u0BAE\u0BCD\u0BAA\u0BBE\u0BB2\u0BC1\u0BAE\u0BCD
      \u0BAE\u0BCB\u0B9F\u0BCD\u0B9F\u0BBE\u0BB0\u0BCD \u0B9A\u0BC8\u0B95\u0BCD\u0B95\u0BBF\u0BB3\u0BCD
      \u0B9A\u0B95\u0BCD\u0B95\u0BB0\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
      \u0B9A\u0BBF\u0BB1\u0BBF\u0BAF \u0BB5\u0BBE\u0B95\u0BA9 \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0BBE\u0B9F\u0BC1\u0B95\u0BB3\u0BBF\u0BB2\u0BCD
      \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u090F\u0915 \u092C\u0947\u092F\u0930\u093F\u0902\u0917 \u091C\u094B \u0909\u091A\u094D\u091A
      \u0930\u0947\u0921\u093F\u092F\u0932 \u0914\u0930 \u0905\u0915\u094D\u0937\u0940\u092F
      \u092D\u093E\u0930 \u0915\u093E \u0938\u092E\u0930\u094D\u0925\u0928 \u0915\u0930\u0928\u0947
      \u0915\u0947 \u0932\u093F\u090F \u0917\u0947\u0902\u0926\u094B\u0902 \u0915\u0940
      \u0926\u094B \u092A\u0902\u0915\u094D\u0924\u093F\u092F\u094B\u0902 \u0915\u093E
      \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0924\u093E \u0939\u0948\u0964
      \u0921\u092C\u0932-\u092A\u0902\u0915\u094D\u0924\u093F \u0921\u093F\u091C\u093C\u093E\u0907\u0928
      \u0932\u094B\u0921 \u0935\u093F\u0924\u0930\u0923, \u0938\u094D\u0925\u093F\u0930\u0924\u093E
      \u0914\u0930 \u0938\u094D\u0925\u093E\u092F\u093F\u0924\u094D\u0935 \u092E\u0947\u0902
      \u0938\u0941\u0927\u093E\u0930 \u0915\u0930\u0924\u093E \u0939\u0948\u0964
      \u0907\u0938\u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0905\u0915\u094D\u0938\u0930
      \u092E\u094B\u091F\u0930\u0938\u093E\u0907\u0915\u093F\u0932 \u092A\u0939\u093F\u092F\u094B\u0902
      \u0914\u0930 \u0915\u0949\u092E\u094D\u092A\u0948\u0915\u094D\u091F \u0911\u091F\u094B\u092E\u094B\u091F\u093F\u0935
      \u0905\u0928\u0941\u092A\u094D\u0930\u092F\u094B\u0917\u094B\u0902 \u092E\u0947\u0902
      \u0915\u093F\u092F\u093E \u091C\u093E\u0924\u093E \u0939\u0948\u0964"
    Object: {fileID: 0}
