  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Hub flange damage or cracks
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0BB9\u0BAA\u0BCD \u0B83\u0BAA\u0BBF\u0BB3\u0BC7\u0BA9\u0BCD\u0B9C\u0BCD
      \u0B9A\u0BC7\u0BA4\u0BAE\u0BCD \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0BB5\u0BBF\u0BB0\u0BBF\u0B9A\u0BB2\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0939\u092C \u092B\u094D\u0932\u0948\u0902\u091C \u0915\u094D\u0937\u0924\u093F
      \u092F\u093E \u0926\u0930\u093E\u0930\u0947\u0902"
    Object: {fileID: 0}
