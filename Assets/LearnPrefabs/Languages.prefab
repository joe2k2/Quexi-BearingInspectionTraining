  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Next, take the  silver cage, insert the balls into it, and ensure they
      are evenly positioned one by one
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BA4\u0BBE\u0B95, \u0BB5\u0BC6\u0BB3\u0BCD\u0BB3\u0BBF
      \u0B95\u0BC7\u0B9C\u0BC8 (Silver Cage) \u0B8E\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1
      \u0B85\u0BA4\u0BBF\u0BB2\u0BCD \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1\u0B95\u0BB3\u0BC8
      \u0B92\u0BB5\u0BCD\u0BB5\u0BCA\u0BA9\u0BCD\u0BB1\u0BBE\u0B95 \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF,
      \u0B85\u0BB5\u0BC8 \u0B9A\u0BAE\u0BAE\u0BBE\u0B95 \u0B85\u0BAE\u0BC8\u0BA8\u0BCD\u0BA4\u0BC1\u0BB3\u0BCD\u0BB3\u0BA4\u0BBE
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0907\u0938\u0915\u0947 \u092C\u093E\u0926, \u0938\u093F\u0932\u094D\u0935\u0930
      \u0915\u0947\u091C (Silver Cage) \u0932\u0947\u0902, \u0909\u0938\u092E\u0947\u0902
      \u092C\u0949\u0932\u094D\u0938 \u0915\u094B \u090F\u0915-\u090F\u0915 \u0915\u0930\u0915\u0947
      \u0921\u093E\u0932\u0947\u0902 \u0914\u0930 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0915\u0930\u0947\u0902 \u0915\u093F \u0935\u0947 \u0938\u092E\u093E\u0928
      \u0930\u0942\u092A \u0938\u0947 \u0938\u094D\u0925\u093F\u0924 \u0939\u094B\u0902\u0964"
    Object: {fileID: 0}
