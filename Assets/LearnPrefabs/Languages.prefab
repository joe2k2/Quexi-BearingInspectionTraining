  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Seal failure causing grease leakage
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B9A\u0BC0\u0BB2\u0BCD \u0BA4\u0BCB\u0BB2\u0BCD\u0BB5\u0BBF \u0B95\u0BBF\u0BB0\u0BC0\u0BB8\u0BCD
      \u0B95\u0B9A\u0BBF\u0BB5\u0BC8 \u0B8F\u0BB1\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0BAE\u0BCD"
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u0938\u0940\u0932 \u0915\u0940 \u0935\u093F\u092B\u0932\u0924\u093E \u0915\u0947
      \u0915\u093E\u0930\u0923 \u0917\u094D\u0930\u0940\u0938 \u0915\u093E \u0930\u093F\u0938\u093E\u0935
      \u0939\u094B \u0930\u0939\u093E \u0939\u0948"
    Object: {fileID: 0}
