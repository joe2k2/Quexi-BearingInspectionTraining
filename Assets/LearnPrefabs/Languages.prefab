--- !u!114 &8690902373883608776
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8890991961282557668}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: After that, carefully place the  ball cage assembly on the opposite side
      of the inner ring and align both rows correctly with their respective raceway
      grooves. Ensure there is no tilting or uneven placement.
    Object: {fileID: 0}
  - Language: Tamil
    Text: "\u0B85\u0BA4\u0BA9\u0BCD \u0BAA\u0BBF\u0BB1\u0B95\u0BC1, \u0BAA\u0BA8\u0BCD\u0BA4\u0BC1
      \u0B95\u0BC7\u0B9C\u0BCD \u0B85\u0B9A\u0BC6\u0BAE\u0BCD\u0BAA\u0BBF\u0BB3\u0BBF\u0BAF\u0BC8
      B1 \u0BB0\u0BBF\u0B99\u0BCD\u0B95\u0BBF\u0BA9\u0BCD \u0B8E\u0BA4\u0BBF\u0BB0\u0BCD\u0BAA\u0BC1\u0BB1\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD
      \u0B95\u0BB5\u0BA9\u0BAE\u0BBE\u0B95 \u0BAA\u0BCA\u0BB0\u0BC1\u0BA4\u0BCD\u0BA4\u0BBF,
      \u0B87\u0BB0\u0BA3\u0BCD\u0B9F\u0BC1 \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8\u0B95\u0BB3\u0BC1\u0BAE\u0BCD
      \u0BA4\u0B99\u0BCD\u0B95\u0BB3\u0BA4\u0BC1 \u0BB0\u0BC7\u0BB8\u0BCD\u0BB5\u0BC7
      \u0B95\u0BC1\u0BB4\u0BBF\u0B95\u0BB3\u0BC1\u0B9F\u0BA9\u0BCD \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0B95
      \u0B92\u0BB4\u0BC1\u0B99\u0BCD\u0B95\u0BC1\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BC1\u0BB3\u0BCD\u0BB3\u0BA9\u0BB5\u0BBE
      \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8 \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD.
      \u0B9A\u0BBE\u0BAF\u0BCD\u0BB5\u0BC1 \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0B9A\u0BAE\u0BAE\u0BB1\u0BCD\u0BB1
      \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1 \u0B87\u0BB0\u0BC1\u0B95\u0BCD\u0B95\u0BBE\u0BA4\u0BA4\u0BC8
      \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
    Object: {fileID: 0}
  - Language: Hindi
    Text: "\u092B\u093F\u0930, \u0926\u0942\u0938\u0930\u0940 \u092C\u0949\u0932
      \u0915\u0947\u091C \u0905\u0938\u0947\u0902\u092C\u0932\u0940 \u0915\u094B
      B1 \u0930\u093F\u0902\u0917 \u0915\u0947 \u0935\u093F\u092A\u0930\u0940\u0924
      \u0926\u093F\u0936\u093E \u092E\u0947\u0902 \u0938\u093E\u0935\u0927\u093E\u0928\u0940\u092A\u0942\u0930\u094D\u0935\u0915
      \u0930\u0916\u0947\u0902 \u0914\u0930 \u0926\u094B\u0928\u094B\u0902 \u092A\u0902\u0915\u094D\u0924\u093F\u092F\u094B\u0902
      \u0915\u094B \u0909\u0928\u0915\u0947 \u0938\u0902\u092C\u0902\u0927\u093F\u0924
      \u0930\u0947\u0938\u0935\u0947 \u0917\u094D\u0930\u0942\u0935\u094D\u0938 \u0915\u0947
      \u0938\u093E\u0925 \u0938\u0939\u0940 \u0922\u0902\u0917 \u0938\u0947 \u0938\u0902\u0930\u0947\u0916\u093F\u0924
      \u0915\u0930\u0947\u0902\u0964 \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924
      \u0915\u0930\u0947\u0902 \u0915\u093F \u0915\u094B\u0908 \u091D\u0941\u0915\u093E\u0935
      \u092F\u093E \u0905\u0938\u092E\u093E\u0928 \u0938\u094D\u0925\u093F\u0924\u093F
      \u0928 \u0939\u094B\u0964"
    Object: {fileID: 0}
